---
import type { ThemeConfig, NavConfig } from '../config/schema';
import Nav from '../components/Nav.astro';
// Tailwind 工具层 + daisyUI 组件层（无 preflight，不改动下方手写令牌与基础排版）
import '../styles/global.css';

// 全局布局：提供 html/head/body 骨架，注入 SEO 元信息与主题 CSS 变量。
interface Props {
  title: string;
  description: string;
  lang?: string;
  author?: string;
  favicon?: string;
  ogImage?: string;
  /** OpenGraph 类型，首页为 website，文章页传 article */
  ogType?: string;
  theme: ThemeConfig;
  /** 全站导航栏配置（可选）；提供时在顶部渲染浮动导航 */
  nav?: NavConfig;
}

const { title, description, lang = 'zh-CN', author, favicon, ogImage, ogType = 'website', theme, nav } = Astro.props;

// 主题色以内联 CSS 变量写在 <html> 上，向下继承给所有区块（含各组件的作用域样式）。
// --site-primary / --site-accent 是给 daisyUI 主题用的别名：daisyUI 主题变量本身
// 也叫 --color-primary，若在那里写 var(--color-primary) 会构成自引用而失效。
const themeVars = `--color-primary:${theme.primaryColor};--color-accent:${theme.accentColor};--site-primary:${theme.primaryColor};--site-accent:${theme.accentColor};`;
---

<!doctype html>
<html lang={lang} style={themeVars}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* 尽早标记 JS 可用：仅当 JS 开启时才隐藏待动画元素，保证禁用 JS 时内容完整可见 */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {author && <meta name="author" content={author} />}
    {favicon && <link rel="icon" href={favicon} />}

    {/* 字体：Inter（拉丁正文/标题）+ JetBrains Mono（标签/代码）；中文回落系统苹方/思源黑体。preconnect 降低阻塞、swap 避免 FOIT */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />

    {/* OpenGraph 社交分享元信息 */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    {/* 供具体页面注入额外的 head 内容（如文章页的 JSON-LD、canonical、文章级 og 标签） */}
    <slot name="head" />
  </head>
  <body id="top">
    {nav && <Nav nav={nav} />}
    <slot />
  </body>
</html>

{/* 全局基础样式：设计令牌、排版与 data-animate 动画契约。data-animate 是跨组件契约，必须全局。 */}
<style is:global>
  :root {
    /* 中性色：zinc 灰阶，冷静克制，让强调色和内容成为焦点 */
    --bg: #fcfcfd;
    --bg-elev: #f6f6f8;
    --fg: #0b0b0f;
    --fg-soft: #27272a;
    --muted: #63636e;
    --muted-strong: #3f3f46;
    --surface: #ffffff;
    --surface-2: #f4f4f5;
    --border: #e7e7ea;
    --border-strong: #d4d4d8;
    /* 强调色梯度：靛蓝 → 紫 → 青，用于渐变文字、光晕与封面 */
    --grad-a: #6366f1;
    --grad-b: #a855f7;
    --grad-c: #06b6d4;
    --grad-brand: linear-gradient(120deg, var(--grad-a) 0%, var(--grad-b) 55%, var(--grad-c) 100%);
    /* 阴影层级：同一套光源，按 elevation 递增 */
    --shadow-xs: 0 1px 2px rgba(16, 16, 24, 0.05);
    --shadow-sm: 0 1px 2px rgba(16, 16, 24, 0.04), 0 2px 6px rgba(16, 16, 24, 0.04);
    --shadow-md: 0 2px 4px rgba(16, 16, 24, 0.04), 0 8px 24px rgba(16, 16, 24, 0.06);
    --shadow-lg: 0 4px 8px rgba(16, 16, 24, 0.04), 0 24px 48px -12px rgba(16, 16, 24, 0.14);
    --max-width: 1120px;
    --radius: 12px;
    --radius-lg: 18px;
    --radius-xl: 24px;
    --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Noto Sans SC',
      'Microsoft YaHei', system-ui, sans-serif;
    --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    /* 缓动 */
    --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  }
  * {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
    /* 锚点跳转时为固定导航栏留出空间 */
    scroll-padding-top: 5rem;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-sans);
    font-feature-settings: 'cv11', 'ss01', 'ss03';
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }
  a {
    color: inherit;
  }
  ::selection {
    background: color-mix(in srgb, var(--color-accent) 22%, transparent);
    color: var(--fg);
  }
  /* 细滚动条 */
  * {
    scrollbar-width: thin;
    scrollbar-color: var(--border-strong) transparent;
  }
  *::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }
  *::-webkit-scrollbar-track {
    background: transparent;
  }
  *::-webkit-scrollbar-thumb {
    background: var(--border-strong);
    border-radius: 999px;
    border: 2px solid var(--bg);
    background-clip: padding-box;
  }
  *::-webkit-scrollbar-thumb:hover {
    background: var(--muted);
  }
  /* 键盘可达：所有可聚焦元素统一焦点环 */
  :focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: 6px;
  }

  /* —— 动画契约：仅在 JS 可用时（html.js）隐藏，否则内容默认可见（渐进增强） —— */
  /* 默认：淡入 + 上移；仅动 transform / opacity，走合成层，60fps 不触发重排 */
  html.js [data-animate] {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 0.7s var(--ease-out),
      transform 0.7s var(--ease-out);
    transition-delay: var(--animate-delay, 0ms);
    will-change: opacity, transform;
  }

  /* 可选变体：通过 data-animate="xxx" 指定不同入场方向/形态 */
  html.js [data-animate='fade'] {
    transform: none;
  }
  html.js [data-animate='scale'] {
    transform: translateY(20px) scale(0.965);
  }
  html.js [data-animate='left'] {
    transform: translateX(-30px);
  }
  html.js [data-animate='right'] {
    transform: translateX(30px);
  }

  html.js [data-animate].in-view {
    opacity: 1;
    transform: none;
  }

  /* 尊重无障碍偏好：减少动态时不做过渡，直接展示终态 */
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    html.js [data-animate] {
      transition: none;
      opacity: 1;
      transform: none;
    }
    *,
    *::before,
    *::after {
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>
