---
import Layout from './Layout.astro';
import rawConfig from '../config/site.config';
import { validateConfig } from '../config/schema';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';

// 文章布局：复用全局 Layout 的 head/SEO 骨架，注入文章级 SEO 与 JSON-LD 结构化数据。
// JSON-LD 是 GEO（生成式引擎优化）的地基，让搜索与 AI 引擎能准确提取文章信息。
interface Props {
  entry: CollectionEntry<'article'>;
  /** 由 render() 自动提取的标题列表，用于生成左侧大纲 */
  headings?: MarkdownHeading[];
}

const { entry, headings = [] } = Astro.props;

// 大纲只取 h2/h3，层级过深不利于阅读；无标题时不渲染 TOC
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const { title, description, pubDate, updatedDate, author, image, canonical, tags } = entry.data;

// 站点级配置用于回落作者、语言、主题色（构建期已在首页校验，此处再校验以保持独立正确）
const config = validateConfig(rawConfig);
const resolvedAuthor = author ?? config.site.author;

// 规范链接：优先用 frontmatter 指定，否则用当前页面绝对地址
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;

// JSON-LD：schema.org Article，字段缺省时不写入，避免输出 undefined
const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  url: canonicalUrl,
};
if (pubDate) jsonLd.datePublished = pubDate.toISOString();
if (updatedDate) jsonLd.dateModified = updatedDate.toISOString();
if (resolvedAuthor) jsonLd.author = { '@type': 'Person', name: resolvedAuthor };
if (image) jsonLd.image = image;
if (tags.length > 0) jsonLd.keywords = tags.join(', ');

// 日期展示文本（供正文头部呈现）
const displayDate = pubDate
  ? new Intl.DateTimeFormat(config.site.lang, { dateStyle: 'long' }).format(pubDate)
  : undefined;
---

<Layout
  title={title}
  description={description}
  lang={config.site.lang}
  author={resolvedAuthor}
  favicon={config.site.favicon}
  ogImage={image ?? config.site.ogImage}
  ogType="article"
  theme={config.theme}
  nav={config.nav}
>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalUrl} />
    {tags.length > 0 && <meta name="keywords" content={tags.join(', ')} />}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  {/* 阅读进度条：固定顶部，用 transform: scaleX 更新（合成层，滚动时不重排） */}
  <div class="reading-progress" aria-hidden="true"><span data-reading-bar></span></div>

  <div class:list={['article-wrap', { 'has-toc': toc.length > 0 }]}>
    {toc.length > 0 && (
      <aside class="toc" aria-label="文章大纲">
        <p class="toc-title">目录</p>
        <nav>
          <ul>
            {toc.map((h) => (
              <li class={`toc-item depth-${h.depth}`}>
                <a href={`#${h.slug}`} data-toc-link={h.slug}>{h.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
    )}

    <main class="article">
      <header class="article-header">
        <h1>{title}</h1>
        <p class="article-desc">{description}</p>
        {(displayDate || tags.length > 0) && (
          <div class="article-meta">
            {displayDate && <time datetime={pubDate?.toISOString()}>{displayDate}</time>}
            {tags.length > 0 && (
              <ul class="article-tags">
                {tags.map((tag) => <li>#{tag}</li>)}
              </ul>
            )}
          </div>
        )}
      </header>
      <article class="article-body">
        <slot />
      </article>
    </main>
  </div>

  <script>
    // 阅读进度条：滚动时用 rAF 合并计算，仅改 transform: scaleX，避免布局抖动
    const bar = document.querySelector<HTMLElement>('[data-reading-bar]');
    if (bar) {
      let ticking = false;
      const update = () => {
        const doc = document.documentElement;
        const scrollable = doc.scrollHeight - doc.clientHeight;
        const ratio = scrollable > 0 ? Math.min(1, doc.scrollTop / scrollable) : 0;
        bar.style.transform = `scaleX(${ratio})`;
        ticking = false;
      };
      const onScroll = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      update();
    }
  </script>

  <script>
    // Mermaid 流程图：仅当页面存在 .mermaid 块时才动态加载 mermaid（按需，不拖累无图页面）
    const blocks = document.querySelectorAll<HTMLElement>('.mermaid');
    if (blocks.length > 0) {
      const isDark = true; // 站点为深色主题
      import('mermaid').then(({ default: mermaid }) => {
        mermaid.initialize({
          startOnLoad: false,
          theme: isDark ? 'dark' : 'default',
          securityLevel: 'strict',
        });
        // 渲染完成后为每张图接入"点击放大"灯箱
        mermaid.run({ nodes: Array.from(blocks) }).then(() => setupMermaidZoom(blocks));
      });
    }

    /**
     * 为已渲染的 mermaid 图接入灯箱：点击放大，支持滚轮缩放与拖拽平移。
     * 全部基于 transform（合成层），交互流畅不卡顿；尊重 prefers-reduced-motion。
     */
    function setupMermaidZoom(nodes: NodeListOf<HTMLElement>) {
      const reduce = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;

      // 惰性创建单例遮罩层，复用于所有图
      let overlay: HTMLDivElement | null = null;
      let stage: HTMLDivElement | null = null;
      let scale = 1;
      let tx = 0;
      let ty = 0;
      let dragging = false;
      let startX = 0;
      let startY = 0;

      const apply = () => {
        if (stage) stage.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
      };

      const close = () => {
        if (!overlay) return;
        overlay.classList.remove('open');
        const done = () => {
          overlay?.setAttribute('hidden', '');
          if (stage) stage.innerHTML = '';
        };
        if (reduce) done();
        else setTimeout(done, 200);
        document.removeEventListener('keydown', onKey);
      };

      const onKey = (e: KeyboardEvent) => {
        if (e.key === 'Escape') close();
      };

      const build = () => {
        overlay = document.createElement('div');
        overlay.className = 'mermaid-lightbox';
        overlay.setAttribute('hidden', '');
        overlay.innerHTML =
          '<button class="mlb-close" aria-label="关闭放大视图">' +
          '<svg viewBox="0 0 24 24" width="22" height="22"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/></svg>' +
          '</button>' +
          '<div class="mlb-stage"></div>' +
          '<p class="mlb-hint">滚轮缩放 · 拖拽平移 · Esc 关闭</p>';
        stage = overlay.querySelector('.mlb-stage');

        // 关闭：点击背景空白或关闭按钮
        overlay.addEventListener('click', (e) => {
          if (e.target === overlay || (e.target as HTMLElement).closest('.mlb-close')) close();
        });
        // 滚轮缩放（以 0.5x–6x 为界）
        overlay.addEventListener(
          'wheel',
          (e) => {
            e.preventDefault();
            const next = scale * (e.deltaY < 0 ? 1.12 : 0.89);
            scale = Math.min(6, Math.max(0.5, next));
            apply();
          },
          { passive: false },
        );
        // 拖拽平移
        stage!.addEventListener('pointerdown', (e) => {
          dragging = true;
          startX = e.clientX - tx;
          startY = e.clientY - ty;
          stage!.setPointerCapture(e.pointerId);
          stage!.classList.add('grabbing');
        });
        stage!.addEventListener('pointermove', (e) => {
          if (!dragging) return;
          tx = e.clientX - startX;
          ty = e.clientY - startY;
          apply();
        });
        const endDrag = () => {
          dragging = false;
          stage!.classList.remove('grabbing');
        };
        stage!.addEventListener('pointerup', endDrag);
        stage!.addEventListener('pointercancel', endDrag);

        document.body.appendChild(overlay);
      };

      const open = (svg: SVGElement) => {
        if (!overlay) build();
        scale = 1;
        tx = 0;
        ty = 0;
        const clone = svg.cloneNode(true) as SVGElement;
        clone.removeAttribute('height');
        stage!.innerHTML = '';
        stage!.appendChild(clone);
        apply();
        overlay!.removeAttribute('hidden');
        // 下一帧加 open 触发淡入过渡
        requestAnimationFrame(() => overlay!.classList.add('open'));
        document.addEventListener('keydown', onKey);
      };

      nodes.forEach((node) => {
        const svg = node.querySelector('svg');
        if (!svg) return;
        node.classList.add('zoomable');
        node.addEventListener('click', () => open(svg));
      });
    }
  </script>

  {toc.length > 0 && (
    <script>
      // 滚动高亮：观察正文标题，进入视口时高亮对应目录项（scroll-spy）
      const links = new Map<string, HTMLAnchorElement>();
      document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]').forEach((a) => {
        links.set(a.dataset.tocLink!, a);
      });

      const headingEls = Array.from(links.keys())
        .map((id) => document.getElementById(id))
        .filter((el): el is HTMLElement => el !== null);

      let activeId = '';
      const setActive = (id: string) => {
        if (id === activeId) return;
        links.get(activeId)?.classList.remove('active');
        links.get(id)?.classList.add('active');
        activeId = id;
      };

      if ('IntersectionObserver' in window && headingEls.length > 0) {
        const observer = new IntersectionObserver(
          (entries) => {
            // 取当前视口内最靠上的可见标题作为激活项
            const visible = entries
              .filter((e) => e.isIntersecting)
              .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
            if (visible.length > 0) setActive(visible[0].target.id);
          },
          { rootMargin: '0px 0px -70% 0px', threshold: [0, 1] },
        );
        headingEls.forEach((el) => observer.observe(el));
        setActive(headingEls[0].id);
      }
    </script>
  )}
</Layout>

<style>
  /* 阅读进度条 */
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 50;
    background: transparent;
  }

  .reading-progress span {
    display: block;
    height: 100%;
    transform-origin: left;
    transform: scaleX(0);
    background: linear-gradient(90deg, var(--color-primary), var(--color-accent));
    box-shadow: 0 0 12px color-mix(in srgb, var(--color-accent) 60%, transparent);
  }

  /* 布局：宽屏时左侧大纲 + 居中正文；窄屏时隐藏大纲，正文单列 */
  .article-wrap {
    max-width: 760px;
    margin: 0 auto;
    /* 顶部留白为浮动导航栏让位 */
    padding: 6.5rem 1.25rem 6rem;
  }

  .article-wrap.has-toc {
    max-width: 1120px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 1024px) {
    .article-wrap.has-toc {
      grid-template-columns: 240px minmax(0, 1fr);
      align-items: start;
    }
  }

  .article {
    min-width: 0;
    max-width: 760px;
    width: 100%;
    margin: 0 auto;
  }

  /* —— 左侧大纲 —— */
  .toc {
    display: none;
  }

  @media (min-width: 1024px) {
    .toc {
      display: block;
      position: sticky;
      top: 6rem;
      max-height: calc(100vh - 8rem);
      overflow-y: auto;
      padding-left: 0.75rem;
      border-left: 1px solid var(--border);
    }
  }

  .toc-title {
    margin: 0 0 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .toc nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc-item {
    margin: 0;
    line-height: 1.4;
  }

  .toc-item.depth-3 {
    padding-left: 0.9rem;
  }

  .toc-item a {
    display: block;
    padding: 0.35rem 0.6rem;
    border-radius: 6px;
    font-size: 0.9rem;
    color: var(--muted);
    text-decoration: none;
    border-left: 2px solid transparent;
    margin-left: -0.75rem;
    transition:
      color 0.2s ease,
      background 0.2s ease,
      border-color 0.2s ease;
  }

  .toc-item.depth-3 a {
    font-size: 0.85rem;
  }

  .toc-item a:hover {
    color: var(--fg);
    background: var(--surface);
  }

  .toc-item a.active {
    color: var(--color-accent);
    border-left-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    box-shadow: -1px 0 10px color-mix(in srgb, var(--color-accent) 30%, transparent);
  }

  /* 锚点跳转时留出顶部余量，标题不贴边 */
  .article-body :global(h2),
  .article-body :global(h3) {
    scroll-margin-top: 2rem;
  }

  .article-header {
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1.5rem;
  }

  .article-header h1 {
    font-size: clamp(1.9rem, 4.5vw, 2.8rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 0 0 0.85rem;
    background: linear-gradient(120deg, var(--fg) 30%, var(--color-accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .article-desc {
    color: var(--muted-strong);
    font-size: 1.08rem;
    margin: 0 0 1.1rem;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .article-tags li {
    color: var(--color-accent);
  }

  /* markdown 正文排版 */
  .article-body {
    font-size: 1.05rem;
  }

  .article-body :global(h2) {
    margin-top: 2.75rem;
    padding-bottom: 0.4rem;
    font-size: 1.55rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    border-bottom: 1px solid var(--border);
  }

  .article-body :global(h3) {
    margin-top: 2rem;
    font-size: 1.2rem;
    font-weight: 600;
  }

  .article-body :global(p) {
    margin: 1.1rem 0;
  }

  .article-body :global(a) {
    color: var(--color-accent);
    text-underline-offset: 3px;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    padding-left: 1.4rem;
  }

  .article-body :global(li) {
    margin: 0.4rem 0;
  }

  .article-body :global(blockquote) {
    margin: 1.5rem 0;
    padding: 0.75rem 1.2rem;
    border-left: 3px solid var(--color-primary);
    border-radius: 0 8px 8px 0;
    background: var(--surface);
    color: var(--muted-strong);
  }

  .article-body :global(pre) {
    padding: 1.1rem 1.2rem;
    border-radius: 12px;
    overflow-x: auto;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid var(--border);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  .article-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  .article-body :global(:not(pre) > code) {
    padding: 0.15em 0.45em;
    border-radius: 5px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    color: var(--color-accent);
  }

  .article-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }

  /* Mermaid 流程图：渲染前隐藏源码文本，渲染后居中展示 */
  .article-body :global(.mermaid) {
    position: relative;
    margin: 1.75rem 0;
    padding: 1.25rem;
    border-radius: 12px;
    background: var(--surface);
    border: 1px solid var(--border);
    text-align: center;
    overflow-x: auto;
    transition:
      border-color 0.25s var(--ease-out),
      background 0.25s var(--ease-out);
  }

  /* 已渲染的图：可点击放大 */
  .article-body :global(.mermaid.zoomable) {
    cursor: zoom-in;
  }

  .article-body :global(.mermaid.zoomable:hover) {
    border-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
    background: var(--surface-2);
  }

  /* 悬停提示：右上角"点击放大"胶囊 */
  .article-body :global(.mermaid.zoomable)::after {
    content: '点击放大';
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
    background: color-mix(in srgb, var(--bg-elev) 85%, transparent);
    border: 1px solid var(--border);
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity 0.2s var(--ease-out),
      transform 0.2s var(--ease-out);
    pointer-events: none;
  }

  .article-body :global(.mermaid.zoomable:hover)::after {
    opacity: 1;
    transform: none;
  }

  /* 未渲染完成前不显示原始定义文本，避免闪烁 */
  .article-body :global(.mermaid:not([data-processed])) {
    color: transparent;
    min-height: 2rem;
  }

  /* —— Mermaid 放大灯箱（JS 动态创建，需全局样式）—— */
  :global(.mermaid-lightbox) {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(4, 4, 10, 0.86);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    opacity: 0;
    transition: opacity 0.2s var(--ease-out);
  }

  :global(.mermaid-lightbox.open) {
    opacity: 1;
  }

  :global(.mermaid-lightbox[hidden]) {
    display: none;
  }

  :global(.mermaid-lightbox .mlb-stage) {
    cursor: grab;
    touch-action: none;
    will-change: transform;
    transform-origin: center center;
  }

  :global(.mermaid-lightbox .mlb-stage.grabbing) {
    cursor: grabbing;
  }

  :global(.mermaid-lightbox .mlb-stage svg) {
    display: block;
    width: min(1200px, 92vw);
    height: auto;
    max-width: none;
    filter: drop-shadow(0 24px 60px rgba(0, 0, 0, 0.55));
    -webkit-user-select: none;
    user-select: none;
  }

  :global(.mermaid-lightbox .mlb-close) {
    position: absolute;
    top: 1.1rem;
    right: 1.1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: color-mix(in srgb, var(--bg-elev) 80%, transparent);
    color: var(--fg);
    cursor: pointer;
    transition:
      background 0.2s var(--ease-out),
      transform 0.2s var(--ease-out);
  }

  :global(.mermaid-lightbox .mlb-close:hover) {
    background: var(--surface-2);
    transform: rotate(90deg);
  }

  :global(.mermaid-lightbox .mlb-hint) {
    position: absolute;
    bottom: 1.2rem;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
    background: color-mix(in srgb, var(--bg-elev) 70%, transparent);
    border: 1px solid var(--border);
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.mermaid-lightbox),
    :global(.mermaid-lightbox .mlb-close) {
      transition: none;
    }
  }
</style>
