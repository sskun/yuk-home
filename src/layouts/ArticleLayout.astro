---
import Layout from './Layout.astro';
import rawConfig from '../config/site.config';
import { validateConfig } from '../config/schema';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';

// 文章布局：复用全局 Layout 的 head/SEO 骨架，注入文章级 SEO 与 JSON-LD 结构化数据。
// JSON-LD 是 GEO（生成式引擎优化）的地基，让搜索与 AI 引擎能准确提取文章信息。
interface Props {
  entry: CollectionEntry<'article'>;
  /** 由 render() 自动提取的标题列表，用于生成左侧大纲 */
  headings?: MarkdownHeading[];
}

const { entry, headings = [] } = Astro.props;

// 大纲只取 h2/h3，层级过深不利于阅读；无标题时不渲染 TOC
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const { title, description, pubDate, updatedDate, author, image, canonical, tags } = entry.data;

// 站点级配置用于回落作者、语言、主题色（构建期已在首页校验，此处再校验以保持独立正确）
const config = validateConfig(rawConfig);
const resolvedAuthor = author ?? config.site.author;

// 规范链接：优先用 frontmatter 指定，否则用当前页面绝对地址
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;

// JSON-LD：schema.org Article，字段缺省时不写入，避免输出 undefined
const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  url: canonicalUrl,
};
if (pubDate) jsonLd.datePublished = pubDate.toISOString();
if (updatedDate) jsonLd.dateModified = updatedDate.toISOString();
if (resolvedAuthor) jsonLd.author = { '@type': 'Person', name: resolvedAuthor };
if (image) jsonLd.image = image;
if (tags.length > 0) jsonLd.keywords = tags.join(', ');

// 日期展示文本（供正文头部呈现）
const displayDate = pubDate
  ? new Intl.DateTimeFormat(config.site.lang, { dateStyle: 'long' }).format(pubDate)
  : undefined;
---

<Layout
  title={title}
  description={description}
  lang={config.site.lang}
  author={resolvedAuthor}
  favicon={config.site.favicon}
  ogImage={image ?? config.site.ogImage}
  ogType="article"
  theme={config.theme}
>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalUrl} />
    {tags.length > 0 && <meta name="keywords" content={tags.join(', ')} />}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class:list={['article-wrap', { 'has-toc': toc.length > 0 }]}>
    {toc.length > 0 && (
      <aside class="toc" aria-label="文章大纲">
        <p class="toc-title">目录</p>
        <nav>
          <ul>
            {toc.map((h) => (
              <li class={`toc-item depth-${h.depth}`}>
                <a href={`#${h.slug}`} data-toc-link={h.slug}>{h.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
    )}

    <main class="article">
      <header class="article-header">
        <h1>{title}</h1>
        <p class="article-desc">{description}</p>
        {(displayDate || tags.length > 0) && (
          <div class="article-meta">
            {displayDate && <time datetime={pubDate?.toISOString()}>{displayDate}</time>}
            {tags.length > 0 && (
              <ul class="article-tags">
                {tags.map((tag) => <li>#{tag}</li>)}
              </ul>
            )}
          </div>
        )}
      </header>
      <article class="article-body">
        <slot />
      </article>
    </main>
  </div>

  <script>
    // Mermaid 流程图：仅当页面存在 .mermaid 块时才动态加载 mermaid（按需，不拖累无图页面）
    const blocks = document.querySelectorAll<HTMLElement>('.mermaid');
    if (blocks.length > 0) {
      const isDark = true; // 站点为深色主题
      import('mermaid').then(({ default: mermaid }) => {
        mermaid.initialize({
          startOnLoad: false,
          theme: isDark ? 'dark' : 'default',
          securityLevel: 'strict',
        });
        mermaid.run({ nodes: Array.from(blocks) });
      });
    }
  </script>

  {toc.length > 0 && (
    <script>
      // 滚动高亮：观察正文标题，进入视口时高亮对应目录项（scroll-spy）
      const links = new Map<string, HTMLAnchorElement>();
      document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]').forEach((a) => {
        links.set(a.dataset.tocLink!, a);
      });

      const headingEls = Array.from(links.keys())
        .map((id) => document.getElementById(id))
        .filter((el): el is HTMLElement => el !== null);

      let activeId = '';
      const setActive = (id: string) => {
        if (id === activeId) return;
        links.get(activeId)?.classList.remove('active');
        links.get(id)?.classList.add('active');
        activeId = id;
      };

      if ('IntersectionObserver' in window && headingEls.length > 0) {
        const observer = new IntersectionObserver(
          (entries) => {
            // 取当前视口内最靠上的可见标题作为激活项
            const visible = entries
              .filter((e) => e.isIntersecting)
              .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
            if (visible.length > 0) setActive(visible[0].target.id);
          },
          { rootMargin: '0px 0px -70% 0px', threshold: [0, 1] },
        );
        headingEls.forEach((el) => observer.observe(el));
        setActive(headingEls[0].id);
      }
    </script>
  )}
</Layout>

<style>
  /* 布局：宽屏时左侧大纲 + 居中正文；窄屏时隐藏大纲，正文单列 */
  .article-wrap {
    max-width: 760px;
    margin: 0 auto;
    padding: 4rem 1.25rem 6rem;
  }

  .article-wrap.has-toc {
    max-width: 1120px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 1024px) {
    .article-wrap.has-toc {
      grid-template-columns: 240px minmax(0, 1fr);
      align-items: start;
    }
  }

  .article {
    min-width: 0;
    max-width: 760px;
    width: 100%;
    margin: 0 auto;
  }

  /* —— 左侧大纲 —— */
  .toc {
    display: none;
  }

  @media (min-width: 1024px) {
    .toc {
      display: block;
      position: sticky;
      top: 2.5rem;
      max-height: calc(100vh - 5rem);
      overflow-y: auto;
      padding-left: 0.75rem;
      border-left: 1px solid var(--border);
    }
  }

  .toc-title {
    margin: 0 0 0.75rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .toc nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc-item {
    margin: 0;
    line-height: 1.4;
  }

  .toc-item.depth-3 {
    padding-left: 0.9rem;
  }

  .toc-item a {
    display: block;
    padding: 0.35rem 0.6rem;
    border-radius: 6px;
    font-size: 0.9rem;
    color: var(--muted);
    text-decoration: none;
    border-left: 2px solid transparent;
    margin-left: -0.75rem;
    transition:
      color 0.2s ease,
      background 0.2s ease,
      border-color 0.2s ease;
  }

  .toc-item.depth-3 a {
    font-size: 0.85rem;
  }

  .toc-item a:hover {
    color: var(--fg);
    background: var(--surface);
  }

  .toc-item a.active {
    color: var(--color-accent);
    border-left-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }

  /* 锚点跳转时留出顶部余量，标题不贴边 */
  .article-body :global(h2),
  .article-body :global(h3) {
    scroll-margin-top: 2rem;
  }

  .article-header {
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1.5rem;
  }

  .article-header h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    line-height: 1.25;
    margin: 0 0 0.75rem;
  }

  .article-desc {
    color: var(--muted);
    margin: 0 0 1rem;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .article-tags li {
    color: var(--color-accent);
  }

  /* markdown 正文排版 */
  .article-body {
    font-size: 1.05rem;
  }

  .article-body :global(h2) {
    margin-top: 2.5rem;
    font-size: 1.5rem;
  }

  .article-body :global(h3) {
    margin-top: 2rem;
    font-size: 1.2rem;
  }

  .article-body :global(p) {
    margin: 1.1rem 0;
  }

  .article-body :global(a) {
    color: var(--color-accent);
    text-underline-offset: 3px;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    padding-left: 1.4rem;
  }

  .article-body :global(li) {
    margin: 0.4rem 0;
  }

  .article-body :global(blockquote) {
    margin: 1.5rem 0;
    padding: 0.5rem 1.1rem;
    border-left: 3px solid var(--color-primary);
    background: var(--surface);
    color: var(--muted);
  }

  .article-body :global(pre) {
    padding: 1rem 1.1rem;
    border-radius: 8px;
    overflow-x: auto;
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid var(--border);
  }

  .article-body :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.92em;
  }

  .article-body :global(:not(pre) > code) {
    padding: 0.15em 0.4em;
    border-radius: 4px;
    background: var(--surface);
  }

  .article-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }

  /* Mermaid 流程图：渲染前隐藏源码文本，渲染后居中展示 */
  .article-body :global(.mermaid) {
    margin: 1.75rem 0;
    padding: 1.25rem;
    border-radius: 10px;
    background: var(--surface);
    border: 1px solid var(--border);
    text-align: center;
    overflow-x: auto;
  }

  /* 未渲染完成前不显示原始定义文本，避免闪烁 */
  .article-body :global(.mermaid:not([data-processed])) {
    color: transparent;
    min-height: 2rem;
  }
</style>
