---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ArticleRow from '../../components/ArticleRow.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import rawConfig from '../../config/site.config';
import { validateConfig } from '../../config/schema';

// 文章列表页（/article）：从 article 集合读取全部非草稿文章，按发布时间倒序展示。
const config = validateConfig(rawConfig);

// 列表页可见文案走配置；未提供时回落到内置缺省文案（保持零硬编码原则）
const meta = config.articleIndex ?? {
  title: '文章',
  description: '全部文章列表',
  heading: '文章',
  intro: undefined as string | undefined,
  eyebrow: undefined as string | undefined,
};

// 过滤草稿：与详情页 [...slug].astro 的策略保持一致
const entries = await getCollection('article', ({ data }) => !data.draft);

// 排序：有 pubDate 者按时间降序（新在前），无日期者排最后并以标题升序稳定次序
entries.sort((a, b) => {
  const ta = a.data.pubDate ? a.data.pubDate.getTime() : -Infinity;
  const tb = b.data.pubDate ? b.data.pubDate.getTime() : -Infinity;
  if (ta !== tb) return tb - ta;
  return a.data.title.localeCompare(b.data.title);
});

const base = config.theme.animationEnabled ? config.theme.animationBaseDelay : 0;
---

<Layout
  title={meta.title}
  description={meta.description}
  lang={config.site.lang}
  author={config.site.author}
  favicon={config.site.favicon}
  ogImage={config.site.ogImage}
  theme={config.theme}
  nav={config.nav}
>
  <main class="article-list">
    <PageHeader
      eyebrow={meta.eyebrow}
      heading={meta.heading}
      intro={meta.intro}
      meta={entries.length > 0 ? `共 ${entries.length} 篇` : undefined}
    />
    <div class="body">
      {
        entries.length > 0 ? (
          <ol class="list">
            {entries.map((entry, i) => (
              <ArticleRow entry={entry} delay={base + i * 70} lang={config.site.lang} headingLevel={2} />
            ))}
          </ol>
        ) : (
          <p class="empty" data-animate style={`--animate-delay:${base}ms`}>
            还没有已发布的文章，敬请期待。
          </p>
        )
      }
    </div>
  </main>
</Layout>

<script>
  // 复用全局动画脚本：卡片进入视口触发，尊重 prefers-reduced-motion
  import { initAnimations } from '../../scripts/animate';
  initAnimations();
</script>

<style>
  .article-list {
    padding-bottom: 6rem;
  }
  .body {
    /* 与 PageHeader 内容区同宽：内容 max-width + 两侧内边距 */
    max-width: calc(var(--max-width) + 3rem);
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }
  .empty {
    text-align: center;
    color: var(--muted);
    padding: 4rem 0;
  }
  @media (max-width: 640px) {
    .body {
      padding: 0 1.25rem;
    }
  }
</style>
