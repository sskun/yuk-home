---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

// 动态路由：为 article 集合中每篇非草稿文档生成静态页面。
// URL 形态：src/content/article/test01.md -> /article/test01
//          src/content/article/guides/setup.md -> /article/guides/setup
export const getStaticPaths: GetStaticPaths = async () => {
  const entries = await getCollection('article', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
};

const { entry } = Astro.props;
// render 将 markdown 编译为可渲染组件，并返回自动提取的标题列表（含 depth/slug/text）
const { Content, headings } = await render(entry);
---

<ArticleLayout entry={entry} headings={headings}>
  <Content />
</ArticleLayout>
