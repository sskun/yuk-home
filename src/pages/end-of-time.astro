---
import '../styles/end-of-time.css';
---
<!doctype html>
<html lang="zh-CN">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content="时间尽头：穿越三片星域，收集时间碎片，点燃一个新的宇宙。"/><title>时间尽头 · The End of Time</title><link rel="icon" href="/favicon-32.png"/></head>
<body>
<main id="observatory">
  <div id="cosmos" role="region" tabindex="0" aria-label="三维星际仪，拖拽环绕、滚轮缩放，方向键旋转"></div>
  <div class="vignette" aria-hidden="true"></div>
  <header class="topbar"><a href="/" class="back">↖ <span>UPWIND / 返回首页</span></a><span class="edition">UPWIND OBSERVATORY / 001</span><button id="sound" aria-pressed="false">声场 <span>关闭</span></button></header>
  <section class="intro">
    <p class="eyebrow"><i></i> 宇宙档案 / 最后一座观测站</p>
    <h1>时间尽头<span>THE CELESTIAL ARCHIVE</span></h1>
    <p class="prose">一枚星核，无数条轨道。<br/>你决定宇宙如何继续。</p>
    <button id="collapse" class="primary" disabled>触发涟漪</button><p class="micro" id="echo-note">每次涟漪持续 8 秒，不连续叠加。</p>
    <details id="mission-panel" class="mission"><summary>探索时间碎片 <b id="progress">0 / 3</b></summary><p id="mission-note">切换阶段，寻找时间碎片。</p><div class="slots" aria-label="时间碎片收集进度"><span data-slot="0">01 起源</span><span data-slot="1">02 潮汐</span><span data-slot="2">03 余烬</span></div>
      <button id="ignite" class="primary" disabled>集齐碎片，点燃新纪元 <span>↗</span></button>
      <button id="restart" class="text-button" hidden>重新探索 ↺</button>
    </details>
  </section>
  <div class="view-switch" role="group" aria-label="观察视角">
    <button data-view="0" aria-pressed="true" disabled>全景</button>
    <button data-view="1" aria-pressed="false" disabled>核心</button>
    <button data-view="2" aria-pressed="false" disabled>极轴</button>
  </div>
  <aside class="observation-note" aria-hidden="true"><span>CELESTIAL ENGINE</span><b>Ω — 001</b><span>静观 · 探索 · 共鸣</span></aside>
  <nav class="realms" aria-label="切换星域">
    <button data-realm="0" aria-pressed="true" disabled><small>01 / ORIGIN</small><b>星际仪</b><span>秩序，始于第一次心跳</span></button>
    <button data-realm="1" aria-pressed="false" disabled><small>02 / TIDAL</small><b>引力潮汐</b><span>所有轨道，都在彼此牵引</span></button>
    <button data-realm="2" aria-pressed="false" disabled><small>03 / EMBER</small><b>最后余烬</b><span>终点，也可以是起点</span></button>
  </nav>
  <button id="beacon" class="beacon" hidden aria-label="收集起源碎片"><span class="beacon-gem">✧</span><span id="beacon-label">拾取 · 起源</span></button>
  <p id="status" role="status">正在连接观测站…</p>
  <footer class="console"><div class="chapter"><span id="chapter-name">01 / 星际仪</span><p id="phase">时间仍在流动</p></div><div class="time-controls"><button id="pause" aria-pressed="false" disabled>▶ 慢速播放</button><label for="time">时间流速 <output id="rate">0.25×</output></label><input id="time" type="range" min="-0.5" max="0.5" value="0.25" step="0.05" aria-label="时间流速，负值倒流" disabled/><button id="reset" disabled aria-label="重置视角和时间">↺ 复位</button></div><div class="gestures">拖拽 · 环绕　滚轮 · 靠近<br/><span>空格 · 暂停　R · 复位　1–3 · 星域</span></div></footer>
  <noscript><div class="fallback">开启 JavaScript，进入时间尽头。<a href="/">返回首页</a></div></noscript>
</main>
<script>import { mountEndOfTime } from '../components/end-of-time/scene'; mountEndOfTime();</script>
</body>
</html>
