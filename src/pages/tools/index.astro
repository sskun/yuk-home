---
import Layout from '../../layouts/Layout.astro';
import ToolList from '../../components/ToolList.astro';
import rawConfig from '../../config/site.config';
import { validateConfig } from '../../config/schema';

// 工具列表页（/tools）：简洁页头 + 竖向列表。
const config = validateConfig(rawConfig);

const meta = config.toolsIndex ?? {
  title: '工具',
  description: '浏览器内可完成的小工具集合',
  heading: '工具',
  intro: undefined as string | undefined,
};

const base = config.theme.animationEnabled ? config.theme.animationBaseDelay : 0;

const toolsSection = config.sections.find((s) => s.type === 'tool-grid');
const items = (meta.items ?? (toolsSection && toolsSection.type === 'tool-grid' ? toolsSection.items : [])) ?? [];
---

<Layout
  title={meta.title}
  description={meta.description}
  lang={config.site.lang}
  author={config.site.author}
  favicon={config.site.favicon}
  ogImage={config.site.ogImage}
  theme={config.theme}
  nav={config.nav}
>
  <main class="tools-page">
    <!-- 页头 -->
    <header class="page-head" data-animate style={`--animate-delay:${base}ms`}>
      <h1 class="page-title">工具</h1>
      <p class="page-desc">
        {meta.intro ?? '所有处理均在浏览器中完成，文件不会上传到任何服务器。'}
      </p>
    </header>

    <!-- 工具列表 -->
    {
      items.length > 0 ? (
        <ToolList items={items} delay={base + 80} />
      ) : (
        <p class="empty" data-animate style={`--animate-delay:${base + 80}ms`}>
          暂无工具，敬请期待。
        </p>
      )
    }
  </main>
</Layout>

<script>
  import { initAnimations } from '../../scripts/animate';
  initAnimations();
</script>

<style>
  .tools-page {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 8rem 1.5rem 4rem;
  }

  /* 页头 */
  .page-head {
    margin-bottom: 2.5rem;
  }

  .page-title {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin: 0 0 0.6rem;
  }

  .page-desc {
    font-size: 0.95rem;
    color: var(--muted);
    margin: 0;
    max-width: 60ch;
    line-height: 1.6;
  }

  /* 空态 */
  .empty {
    color: var(--muted);
    font-size: 0.95rem;
    padding: 3rem 0;
  }

  /* 响应式 */
  @media (max-width: 640px) {
    .tools-page {
      padding: 7rem 1.25rem 3rem;
    }
  }
</style>
