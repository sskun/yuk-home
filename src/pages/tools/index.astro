---
import Layout from '../../layouts/Layout.astro';
import ToolCards from '../../components/ToolCards.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import rawConfig from '../../config/site.config';
import { validateConfig } from '../../config/schema';

// 工具列表页（/tools）：简洁页头 + 竖向列表。
const config = validateConfig(rawConfig);

const meta = config.toolsIndex ?? {
  title: '工具',
  description: '浏览器内可完成的小工具集合',
  heading: '工具',
  intro: undefined as string | undefined,
  eyebrow: undefined as string | undefined,
};

const base = config.theme.animationEnabled ? config.theme.animationBaseDelay : 0;

const toolsSection = config.sections.find((s) => s.type === 'tool-grid');
const items = (meta.items ?? (toolsSection && toolsSection.type === 'tool-grid' ? toolsSection.items : [])) ?? [];
---

<Layout
  title={meta.title}
  description={meta.description}
  lang={config.site.lang}
  author={config.site.author}
  favicon={config.site.favicon}
  ogImage={config.site.ogImage}
  theme={config.theme}
  nav={config.nav}
>
  <main class="tools-page">
    <PageHeader
      eyebrow={meta.eyebrow}
      heading={meta.heading}
      intro={meta.intro ?? '所有处理均在浏览器中完成，文件不会上传到任何服务器。'}
    />
    <div class="body">
      {
        items.length > 0 ? (
          <ToolCards items={items} delay={base + 80} comingSoon={config.toolsIndex?.comingSoon} />
        ) : (
          <p class="empty" data-animate style={`--animate-delay:${base + 80}ms`}>
            暂无工具，敬请期待。
          </p>
        )
      }
    </div>
  </main>
</Layout>

<script>
  import { initAnimations } from '../../scripts/animate';
  initAnimations();
</script>

<style>
  .tools-page {
    padding-bottom: 6rem;
  }
  .body {
    /* 与 PageHeader 内容区同宽：内容 max-width + 两侧内边距 */
    max-width: calc(var(--max-width) + 3rem);
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .empty {
    color: var(--muted);
    font-size: 0.95rem;
    padding: 3rem 0;
  }
  @media (max-width: 640px) {
    .body {
      padding: 0 1.25rem;
    }
  }
</style>
