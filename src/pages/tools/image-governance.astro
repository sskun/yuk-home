---
// 图片治理：浏览器端裁剪与按体积压缩，文件不离开设备。
// 页头由这里渲染，工具主体由 src/components/tools/ImageGovernance.ts 挂载（需要 JavaScript）。
import Base from '../../layouts/Base.astro';
import Crumb from '../../components/site/Crumb.astro';
import PageHead from '../../components/site/PageHead.astro';
import { Toaster } from '@/components/starwind/toast';
import { getEntry } from 'astro:content';
import '../../styles/image-tool.css';

const tool = await getEntry('tools', 'image-governance');
const description = tool?.data.tagline ?? '浏览器里裁剪到指定尺寸、按目标体积压缩，不上传文件。';
---

<Base title="图片治理" description={description}>
  <Crumb items={[{ label: '工具库', href: '/tools' }, { label: '图片治理' }]} />
  <PageHead kick="我做的 · 全部在浏览器里完成" title="图片治理" dek="裁剪到指定像素尺寸，或按目标体积压缩。文件全程不离开你的设备，也不需要账号。">
    <Fragment slot="stats">
      <span>格式 <b>JPEG / PNG / WebP</b></span>
      <span>单张上限 <b>20</b> MB</span>
      <span>上传 <b>0</b> 字节</span>
    </Fragment>
  </PageHead>
  <div id="ig-root" class="ig-root" aria-label="图片治理工具">
    <noscript><p class="ig-noscript">这个工具需要开启 JavaScript 才能使用。</p></noscript>
  </div>
  <Toaster position="bottom-right" duration={3500} />
</Base>

<script>
  import { mountImageGovernance } from '../../components/tools/ImageGovernance';
  import { onPageLoad } from '../../scripts/lifecycle';
  onPageLoad(() => {
    const root = document.getElementById('ig-root');
    return root ? mountImageGovernance(root) : undefined;
  });
</script>
