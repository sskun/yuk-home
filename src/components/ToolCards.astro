---
import type { ToolItem } from '../config/schema';
import Icon from './ui/Icon.astro';

// 工具列表页卡片网格：ready 工具可点击，wip 工具置灰并标"规划中"；
// 末尾可选一张"更多工具开发中"占位卡，工具少时网格不显得空。
interface Props {
  items: ToolItem[];
  delay: number;
  comingSoon?: { title: string; description: string };
}
const { items, delay, comingSoon } = Astro.props;

// 未配置 accent 时按序号轮换
const PALETTE: [string, string][] = [
  ['#6366f1', '#a855f7'],
  ['#06b6d4', '#10b981'],
  ['#f59e0b', '#ef4444'],
  ['#ec4899', '#8b5cf6'],
  ['#3b82f6', '#06b6d4'],
];
const sorted = [...items.filter((i) => i.status !== 'wip'), ...items.filter((i) => i.status === 'wip')];
const hrefOf = (item: ToolItem) => item.href ?? `/tools/${item.slug}`;
---

<ul class="tool-grid" role="list">
  {
    sorted.map((item, i) => {
      const [c1, c2] = item.accent ?? PALETTE[i % PALETTE.length];
      const wip = item.status === 'wip';
      const Tag = wip ? 'div' : 'a';
      return (
        <li data-animate="scale" style={`--animate-delay:${delay + i * 70}ms`}>
          <Tag
            class:list={['tool-card', { wip }]}
            href={wip ? undefined : hrefOf(item)}
            target={!wip && item.external ? '_blank' : undefined}
            rel={!wip && item.external ? 'noopener noreferrer' : undefined}
            aria-disabled={wip ? 'true' : undefined}
            data-tool-card
            style={`--c1:${c1};--c2:${c2}`}
          >
            <span class="ring-border" aria-hidden="true" />
            <div class="visual" aria-hidden="true">
              <span class="mesh" />
              <span class="grid-lines" />
              <span class="orbit orbit-1" />
              <span class="orbit orbit-2" />
              <span class="tile">
                <Icon name={item.icon} size={28} strokeWidth={1.6} />
                <span class="bracket tl" />
                <span class="bracket tr" />
                <span class="bracket bl" />
                <span class="bracket br" />
              </span>
              <span class="sheen" />
            </div>
            <div class="body">
              <div class="head">
                <h2 class="name">{item.title}</h2>
                <span class:list={['status', { wip }]}>
                  <span class="status-dot" aria-hidden="true" />
                  {wip ? '规划中' : '可用'}
                </span>
              </div>
              <p class="desc">{item.description}</p>
              {item.tags && item.tags.length > 0 && (
                <ul class="tags" aria-label="标签">
                  {item.tags.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              )}
              {!wip && (
                <span class="open">
                  打开工具
                  <Icon name={item.external ? 'arrowUpRight' : 'arrowRight'} size={16} strokeWidth={2} />
                </span>
              )}
            </div>
          </Tag>
        </li>
      );
    })
  }
  {
    comingSoon && (
      <li data-animate="scale" style={`--animate-delay:${delay + sorted.length * 70}ms`}>
        <div class="soon">
          <span class="soon-icon" aria-hidden="true">
            <Icon name="sparkles" size={22} />
          </span>
          <p class="soon-title">{comingSoon.title}</p>
          <p class="soon-desc">{comingSoon.description}</p>
        </div>
      </li>
    )
  }
</ul>

<script>
  // 指针聚光灯 + 轻微 3D 倾斜：仅精确指针设备、未开启减少动态时启用；只写 CSS 变量。
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (fine) {
    document.querySelectorAll<HTMLElement>('[data-tool-card]:not(.wip)').forEach((card) => {
      let frame = 0;
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        const x = e.clientX - r.left;
        const y = e.clientY - r.top;
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          card.style.setProperty('--mx', `${x}px`);
          card.style.setProperty('--my', `${y}px`);
          if (!reduce) {
            card.style.setProperty('--ry', `${((x / r.width - 0.5) * 6).toFixed(2)}deg`);
            card.style.setProperty('--rx', `${((0.5 - y / r.height) * 5).toFixed(2)}deg`);
          }
        });
      });
      card.addEventListener('pointerleave', () => {
        cancelAnimationFrame(frame);
        card.style.setProperty('--rx', '0deg');
        card.style.setProperty('--ry', '0deg');
      });
    });
  }
</script>

<style>
  /* 旋转渐变描边所需的可动画角度 */
  @property --angle {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }

  .tool-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tool-grid > li {
    display: flex;
    perspective: 1000px;
  }

  /* ---------- 卡片 ---------- */
  .tool-card {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    border-radius: 22px;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    color: inherit;
    text-decoration: none;
    isolation: isolate;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition:
      transform 0.45s var(--ease-out),
      box-shadow 0.45s var(--ease-out),
      border-color 0.45s var(--ease-out);
  }
  a.tool-card:hover {
    transform: translateY(-6px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    border-color: transparent;
    box-shadow:
      var(--shadow-lg),
      0 20px 40px -20px color-mix(in srgb, var(--c1) 45%, transparent);
  }
  a.tool-card:active {
    transform: translateY(-2px) scale(0.985);
    transition-duration: 0.15s;
  }
  /* 指针聚光灯，叠在内容之上但不拦截事件 */
  a.tool-card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
    border-radius: inherit;
    pointer-events: none;
    background: radial-gradient(
      380px circle at var(--mx, 50%) var(--my, 0%),
      color-mix(in srgb, var(--c1) 9%, transparent),
      transparent 50%
    );
    opacity: 0;
    transition: opacity 0.4s var(--ease-out);
  }
  a.tool-card:hover::after {
    opacity: 1;
  }

  /* 悬停时出现并缓慢旋转的渐变描边（mask 只保留 1.5px 边框区域） */
  .ring-border {
    position: absolute;
    inset: -1px;
    z-index: 4;
    border-radius: inherit;
    padding: 1.5px;
    background: conic-gradient(from var(--angle), var(--c1), var(--c2), transparent 40%, transparent 60%, var(--c1));
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s var(--ease-out);
  }
  a.tool-card:hover .ring-border {
    opacity: 1;
    animation: spin-border 4s linear infinite;
  }
  @keyframes spin-border {
    to {
      --angle: 360deg;
    }
  }

  /* ---------- 视觉区 ---------- */
  .visual {
    position: relative;
    height: 168px;
    overflow: hidden;
    border-radius: 21px 21px 0 0;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--c1) 6%, white);
  }
  .mesh {
    position: absolute;
    inset: -20%;
    background:
      radial-gradient(40% 50% at 25% 30%, color-mix(in srgb, var(--c1) 30%, transparent), transparent 70%),
      radial-gradient(45% 55% at 80% 70%, color-mix(in srgb, var(--c2) 26%, transparent), transparent 70%);
    animation: mesh-drift 14s ease-in-out infinite alternate;
  }
  @keyframes mesh-drift {
    to {
      transform: translate3d(6%, -4%, 0) rotate(8deg);
    }
  }
  .grid-lines {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(color-mix(in srgb, var(--c1) 12%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--c1) 12%, transparent) 1px, transparent 1px);
    background-size: 24px 24px;
    background-position: center;
    mask-image: radial-gradient(ellipse 55% 75% at 50% 50%, #000 15%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 55% 75% at 50% 50%, #000 15%, transparent 75%);
    transition: transform 0.8s var(--ease-out);
  }
  a.tool-card:hover .grid-lines {
    transform: scale(1.12);
  }
  /* 围绕图标的轨道圆环：悬停时扩散并旋转 */
  .orbit {
    position: absolute;
    left: 50%;
    top: 50%;
    border-radius: 50%;
    border: 1px dashed color-mix(in srgb, var(--c1) 35%, transparent);
    transform: translate(-50%, -50%) scale(0.85);
    opacity: 0.6;
    transition:
      transform 0.7s var(--ease-out),
      opacity 0.7s var(--ease-out);
  }
  .orbit-1 {
    width: 120px;
    height: 120px;
  }
  .orbit-2 {
    width: 184px;
    height: 184px;
    border-style: solid;
    border-color: color-mix(in srgb, var(--c2) 18%, transparent);
  }
  a.tool-card:hover .orbit-1 {
    transform: translate(-50%, -50%) scale(1) rotate(90deg);
    opacity: 1;
  }
  a.tool-card:hover .orbit-2 {
    transform: translate(-50%, -50%) scale(1.06);
    opacity: 1;
  }
  .tile {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 18px;
    color: #fff;
    background: linear-gradient(145deg, var(--c1), var(--c2));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.35),
      0 14px 28px -10px color-mix(in srgb, var(--c1) 75%, transparent);
    transform: translate(-50%, -50%);
    animation: float 5s ease-in-out infinite;
    transition: box-shadow 0.5s var(--ease-out);
  }
  @keyframes float {
    50% {
      transform: translate(-50%, calc(-50% - 5px));
    }
  }
  a.tool-card:hover .tile {
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.35),
      0 20px 36px -10px color-mix(in srgb, var(--c1) 85%, transparent);
  }
  .tile :global(svg) {
    transition: transform 0.5s var(--ease-out);
  }
  a.tool-card:hover .tile :global(svg) {
    transform: scale(1.1) rotate(-6deg);
  }
  /* 取景框四角：悬停时从外向内收拢到图标周围 */
  .bracket {
    position: absolute;
    width: 12px;
    height: 12px;
    border: 0 solid color-mix(in srgb, var(--c1) 70%, var(--fg));
    opacity: 0;
    transition:
      transform 0.5s var(--ease-out),
      opacity 0.4s var(--ease-out);
  }
  .bracket.tl {
    top: -12px;
    left: -12px;
    border-top-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 4px;
    transform: translate(-10px, -10px);
  }
  .bracket.tr {
    top: -12px;
    right: -12px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-top-right-radius: 4px;
    transform: translate(10px, -10px);
  }
  .bracket.bl {
    bottom: -12px;
    left: -12px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-bottom-left-radius: 4px;
    transform: translate(-10px, 10px);
  }
  .bracket.br {
    bottom: -12px;
    right: -12px;
    border-bottom-width: 2px;
    border-right-width: 2px;
    border-bottom-right-radius: 4px;
    transform: translate(10px, 10px);
  }
  a.tool-card:hover .bracket {
    opacity: 1;
    transform: none;
  }
  /* 斜向高光扫过 */
  .sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 35%, rgba(255, 255, 255, 0.55) 50%, transparent 65%);
    transform: translateX(-110%);
  }
  a.tool-card:hover .sheen {
    transform: translateX(110%);
    transition: transform 0.9s var(--ease-out);
  }

  /* ---------- 文字区 ---------- */
  .body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
    padding: 1.4rem 1.5rem 1.5rem;
  }
  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .name {
    margin: 0;
    font-size: 1.1875rem;
    font-weight: 650;
    letter-spacing: -0.015em;
    color: var(--fg);
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    flex-shrink: 0;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 500;
    color: #15803d;
    background: #f0fdf4;
    border: 1px solid #dcfce7;
  }
  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }
  .status.wip {
    color: var(--muted);
    background: var(--surface-2);
    border-color: var(--border);
  }
  .desc {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--muted);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tags li {
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted-strong);
    background: var(--surface-2);
  }
  .open {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: auto;
    padding-top: 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--fg);
  }
  .open :global(svg) {
    transition: transform 0.3s var(--ease-out);
  }
  a.tool-card:hover .open {
    color: color-mix(in srgb, var(--c1) 80%, var(--fg));
  }
  a.tool-card:hover .open :global(svg) {
    transform: translateX(4px);
  }

  /* ---------- 规划中 ---------- */
  .tool-card.wip {
    cursor: default;
    box-shadow: none;
    border-style: dashed;
  }
  .tool-card.wip .visual {
    filter: grayscale(0.85);
    opacity: 0.7;
  }
  .tool-card.wip .tile {
    animation: none;
  }

  /* ---------- 占位卡 ---------- */
  .soon {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 320px;
    padding: 2rem;
    border-radius: 22px;
    border: 1.5px dashed var(--border-strong);
    background:
      radial-gradient(circle at 1px 1px, color-mix(in srgb, var(--fg) 8%, transparent) 1px, transparent 0) 0 0 / 20px 20px,
      var(--bg-elev);
    text-align: center;
  }
  .soon-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-bottom: 0.4rem;
    border-radius: 14px;
    color: var(--color-accent);
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-xs);
    animation: twinkle 3.2s ease-in-out infinite;
  }
  @keyframes twinkle {
    50% {
      transform: rotate(12deg) scale(1.06);
    }
  }
  .soon-title {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--fg-soft);
  }
  .soon-desc {
    margin: 0;
    max-width: 22em;
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .soon {
      min-height: 200px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mesh,
    .tile,
    .soon-icon,
    a.tool-card:hover .ring-border {
      animation: none;
    }
    .tool-card,
    a.tool-card:hover {
      transform: none;
    }
    .sheen {
      display: none;
    }
  }
</style>
