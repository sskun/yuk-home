---
import type { CollectionEntry } from 'astro:content';
import Icon from './ui/Icon.astro';

// 文章列表行：日期 | 标题 + 摘要 + 标签 | 箭头。首页「最新文章」与 /article 列表共用。
interface Props {
  entry: CollectionEntry<'article'>;
  delay: number;
  lang: string;
  /** 标题层级：首页区块内用 h3，列表页用 h2 */
  headingLevel?: 2 | 3;
}
const { entry, delay, lang, headingLevel = 3 } = Astro.props;
const { title, description, pubDate, tags } = entry.data;
const fmt = new Intl.DateTimeFormat(lang, { year: 'numeric', month: '2-digit', day: '2-digit' });
const Heading = headingLevel === 2 ? 'h2' : 'h3';
---

<li class="item" data-animate style={`--animate-delay:${delay}ms`}>
  <a class="row" href={`/article/${entry.id}`}>
    {pubDate ? <time class="date" datetime={pubDate.toISOString()}>{fmt.format(pubDate)}</time> : <span class="date" />}
    <div class="main">
      <Heading class="title">{title}</Heading>
      <p class="desc">{description}</p>
      {
        tags.length > 0 && (
          <ul class="tags">
            {tags.slice(0, 4).map((t) => (
              <li>#{t}</li>
            ))}
          </ul>
        )
      }
    </div>
    <span class="go" aria-hidden="true">
      <Icon name="arrowRight" size={18} strokeWidth={2} />
    </span>
  </a>
</li>

<style>
  .item {
    border-bottom: 1px solid var(--border);
  }
  .row {
    position: relative;
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr) auto;
    align-items: start;
    gap: 2rem;
    padding: 1.75rem 1rem;
    margin: 0 -1rem;
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    transition: background-color 0.25s var(--ease-out);
  }
  .row:hover {
    background: var(--bg-elev);
  }
  .date {
    padding-top: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .main {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }
  .title {
    margin: 0;
    font-size: 1.1875rem;
    font-weight: 650;
    line-height: 1.45;
    letter-spacing: -0.015em;
    color: var(--fg);
    transition: color 0.2s var(--ease-out);
  }
  .row:hover .title {
    color: var(--color-accent);
  }
  .desc {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.85rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }
  .go {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    color: var(--muted);
    border: 1px solid var(--border);
    background: var(--surface);
    transition:
      color 0.25s var(--ease-out),
      background-color 0.25s var(--ease-out),
      border-color 0.25s var(--ease-out),
      transform 0.25s var(--ease-out);
  }
  .row:hover .go {
    color: #fff;
    background: var(--fg);
    border-color: var(--fg);
    transform: translateX(2px);
  }
  @media (max-width: 720px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.5rem;
      padding: 1.5rem 0.75rem;
      margin: 0 -0.75rem;
    }
    .go {
      display: none;
    }
  }
</style>
