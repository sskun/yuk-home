---
import type { FeatureSection } from '../config/schema';
import Icon from './ui/Icon.astro';
import SectionHeader from './ui/SectionHeader.astro';

interface Props {
  data: FeatureSection;
  delay: number;
}
const { data, delay } = Astro.props;
// 每张卡片图标底色轮换，与项目封面同一套色板
const TINTS = ['#6366f1', '#06b6d4', '#a855f7', '#f59e0b'];
---

<section id={data.id} class="feature">
  <div class="inner">
    <SectionHeader eyebrow={data.eyebrow} heading={data.heading} intro={data.intro} delay={delay} />
    <div class="grid">
      {
        data.features.map((f, i) => (
          <article
            class="card"
            data-animate
            style={`--animate-delay:${delay + 80 + i * 80}ms;--tint:${TINTS[i % TINTS.length]}`}
          >
            {f.icon && (
              <span class="icon">
                <Icon name={f.icon} size={22} />
              </span>
            )}
            <h3 class="card-title">{f.title}</h3>
            <p class="card-desc">{f.description}</p>
            {f.tags && f.tags.length > 0 && (
              <ul class="chips">
                {f.tags.map((t) => (
                  <li class="chip">{t}</li>
                ))}
              </ul>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .feature {
    position: relative;
    padding: 6rem 1.5rem;
    background: var(--bg-elev);
    border-block: 1px solid var(--border);
  }
  .inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-xs);
    overflow: hidden;
    transition:
      border-color 0.3s var(--ease-out),
      box-shadow 0.3s var(--ease-out),
      transform 0.3s var(--ease-out);
  }
  /* 右上角色彩光晕，悬停时增强 */
  .card::after {
    content: '';
    position: absolute;
    top: -60px;
    right: -60px;
    width: 160px;
    height: 160px;
    border-radius: 50%;
    background: var(--tint);
    filter: blur(50px);
    opacity: 0.08;
    transition: opacity 0.4s var(--ease-out);
    pointer-events: none;
  }
  .card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--tint) 30%, var(--border));
    box-shadow: var(--shadow-md);
  }
  .card:hover::after {
    opacity: 0.2;
  }
  .icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-bottom: 0.6rem;
    border-radius: 12px;
    color: var(--tint);
    background: color-mix(in srgb, var(--tint) 10%, white);
    border: 1px solid color-mix(in srgb, var(--tint) 18%, white);
    font-size: 1.3rem;
    line-height: 1;
  }
  .card-title {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    color: var(--fg);
  }
  .card-desc {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--muted);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.6rem 0 0;
    padding: 0;
    list-style: none;
  }
  .chip {
    padding: 0.25rem 0.65rem;
    border-radius: 8px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted-strong);
    background: var(--surface-2);
    border: 1px solid var(--border);
    transition:
      color 0.2s var(--ease-out),
      border-color 0.2s var(--ease-out);
  }
  .card:hover .chip {
    border-color: color-mix(in srgb, var(--tint) 20%, var(--border));
  }
  @media (max-width: 640px) {
    .feature {
      padding: 4.5rem 1.25rem;
    }
    .inner {
      gap: 2rem;
    }
    .card {
      padding: 1.5rem;
    }
  }
</style>
