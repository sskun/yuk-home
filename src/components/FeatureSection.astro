---
import type { FeatureSection } from '../config/schema';

// 特性介绍区块：区块标题 + 引言 + 特性卡片网格。
interface Props {
  data: FeatureSection;
  delay: number;
}
const { data, delay } = Astro.props;
---

<section id={data.id} class="feature">
  <div class="inner">
    <h2 class="heading" data-animate style={`--animate-delay:${delay}ms`}>{data.heading}</h2>
    {data.intro && <p class="intro" data-animate style={`--animate-delay:${delay + 100}ms`}>{data.intro}</p>}
    <div class="grid">
      {
        data.features.map((f, i) => (
          <article class="card" data-animate="scale" style={`--animate-delay:${delay + 150 + i * 80}ms`}>
            {f.icon && <div class="icon">{f.icon}</div>}
            <h3 class="card-title">{f.title}</h3>
            <p class="card-desc">{f.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .feature {
    padding: 6rem 2rem;
  }

  .inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .heading {
    font-size: clamp(1.8rem, 4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.015em;
    text-align: center;
    margin: 0 0 0.75rem;
  }

  .intro {
    text-align: center;
    color: var(--muted);
    margin: 0 auto 3rem;
    max-width: 40rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .card {
    position: relative;
    padding: 1.85rem;
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--border);
    backdrop-filter: blur(10px);
    overflow: hidden;
    transition:
      transform 0.3s var(--ease-out),
      border-color 0.3s var(--ease-out),
      background 0.3s var(--ease-out);
  }

  /* 悬停时顶部浮现一条渐变高光，强化"可交互"信号，不引起布局位移 */
  .card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-accent), transparent);
    opacity: 0;
    transition: opacity 0.3s var(--ease-out);
  }

  .card:hover {
    transform: translateY(-6px);
    border-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
    background: var(--surface-2);
  }

  .card:hover::before {
    opacity: 1;
  }

  .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: 1rem;
    font-size: 1.6rem;
    line-height: 1;
    border-radius: 12px;
    background: color-mix(in srgb, var(--color-primary) 16%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-primary) 30%, transparent);
  }

  .card-title {
    margin: 0 0 0.5rem;
    font-size: 1.2rem;
    font-weight: 600;
  }

  .card-desc {
    margin: 0;
    color: var(--muted);
  }
</style>
