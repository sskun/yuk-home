---
import type { Section, ThemeConfig } from '../config/schema';
import HeroSection from './HeroSection.astro';
import FeatureSection from './FeatureSection.astro';
import ShowcaseSection from './ShowcaseSection.astro';
import ToolGridSection from './ToolGridSection.astro';
import ArticlesSection from './ArticlesSection.astro';
import ContactSection from './ContactSection.astro';
import FooterSection from './FooterSection.astro';

// 区块分发器：按 section.type 分发到对应组件；未知类型安全跳过并告警。
interface Props {
  section: Section;
  index: number;
  theme: ThemeConfig;
  /** 站点语言，用于日期本地化 */
  lang?: string;
}
const { section, index, theme, lang } = Astro.props;

// 动画延迟：区块都是滚动进入视口才触发，按序号叠加延迟会让靠后区块入场明显迟钝；
// 因此只给首屏之后的区块一个基础延迟，区块内部各元素再自行错峰。
const animateOn = theme.animationEnabled && section.animate !== false;
const delay = animateOn && index > 0 ? Math.min(theme.animationBaseDelay, 120) : 0;
---

{
  section.type === 'hero' ? (
    <HeroSection data={section} delay={delay} />
  ) : section.type === 'feature' ? (
    <FeatureSection data={section} delay={delay} />
  ) : section.type === 'showcase' ? (
    <ShowcaseSection data={section} delay={delay} />
  ) : section.type === 'tool-grid' ? (
    <ToolGridSection data={section} delay={delay} />
  ) : section.type === 'articles' ? (
    <ArticlesSection data={section} delay={delay} lang={lang} />
  ) : section.type === 'contact' ? (
    <ContactSection data={section} delay={delay} />
  ) : section.type === 'footer' ? (
    <FooterSection data={section} delay={delay} />
  ) : (
    // 未知类型：不渲染任何 DOM，仅在构建期告警（正常情况下已被 validateConfig 拦截）
    (console.warn(`[SectionRenderer] 未知区块类型，已跳过：${(section as { type: string }).type}`), null)
  )
}
