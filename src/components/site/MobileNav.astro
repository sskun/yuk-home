---
import { NAV, SITE, isActive } from '../../consts';
import Icon from './Icon.astro';
const path = Astro.url.pathname;
---
<dialog class="drawer" id="site-drawer" data-dialog aria-label="站点导航">
  <div class="drawer-top">
    <a class="brand" href="/">{SITE.brand}<span class="mk" aria-hidden="true">{SITE.mark}</span><span class="en">{SITE.brandEn}</span></a>
    <button type="button" class="menu-btn" style="display:inline-flex" data-close aria-label="关闭菜单"><Icon name="close" /></button>
  </div>
  <nav aria-label="主导航">
    <a href="/" aria-current={path === '/' ? 'page' : undefined}>首页</a>
    {NAV.map((n) => <a href={n.href} aria-current={isActive(path, n.href) ? 'page' : undefined}>{n.label}</a>)}
  </nav>
  <p class="lb">联系</p>
  <div class="contact" style="margin-top:10px;padding-top:0;border:0">
    <a href={`mailto:${SITE.email}`}><Icon name="mail" size={14} />{SITE.email}</a>
    <a href={SITE.github} target="_blank" rel="noopener noreferrer"><Icon name="github" size={14} />{SITE.githubLabel}</a>
  </div>
</dialog>
