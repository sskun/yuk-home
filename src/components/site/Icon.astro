---
// 16px 线性图标，stroke-width 1.5（设计规格：不用 emoji 当图标）
interface Props {
  name: 'search' | 'menu' | 'close' | 'arrow' | 'ext' | 'down' | 'mail' | 'github' | 'rss';
  size?: number;
  class?: string;
}
const { name, size = 16, class: className } = Astro.props;
const paths: Record<Props['name'], string> = {
  search: '<circle cx="7" cy="7" r="4.8"/><path d="M10.7 10.7 14 14"/>',
  menu: '<path d="M2.5 4.5h11M2.5 8h11M2.5 11.5h11"/>',
  close: '<path d="m4 4 8 8M12 4l-8 8"/>',
  arrow: '<path d="M3 8h10M9 4l4 4-4 4"/>',
  ext: '<path d="M6 3.5H3.5v9h9V10M9 3h4v4M13 3 7.5 8.5"/>',
  down: '<path d="M8 3v10M4 9l4 4 4-4"/>',
  mail: '<rect x="2" y="3.5" width="12" height="9" rx="1.5"/><path d="m2.5 4.5 5.5 4 5.5-4"/>',
  github: '<path d="M6 13c-3 1-3-1.5-4-2m8 3v-2.2c0-.7-.1-1.2-.5-1.6 1.7-.2 3.5-.8 3.5-3.7 0-.8-.3-1.5-.8-2.1.1-.2.3-1-.1-2.1 0 0-.6-.2-2.1.8a7 7 0 0 0-3.8 0C4.7 2 4.1 2.2 4.1 2.2c-.4 1.1-.2 1.9-.1 2.1-.5.6-.8 1.3-.8 2.1 0 2.9 1.8 3.5 3.5 3.7-.3.3-.5.8-.5 1.4V14"/>',
  rss: '<path d="M3 3a10 10 0 0 1 10 10M3 7a6 6 0 0 1 6 6"/><circle cx="3.5" cy="12.5" r="1"/>',
};
---
<svg class={className} width={size} height={size} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={paths[name]} />
