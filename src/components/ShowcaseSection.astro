---
import type { ShowcaseSection } from '../config/schema';
import Icon from './ui/Icon.astro';
import SectionHeader from './ui/SectionHeader.astro';

interface Props {
  data: ShowcaseSection;
  delay: number;
}
const { data, delay } = Astro.props;

// 无缩略图时按序号轮换的封面配色（两段渐变 + 一个高光色）
const PALETTES = [
  ['#6366f1', '#a855f7', '#c7d2fe'],
  ['#06b6d4', '#10b981', '#a5f3fc'],
  ['#f59e0b', '#ef4444', '#fde68a'],
  ['#ec4899', '#3b82f6', '#fbcfe8'],
];
const count = data.items.length;
// 列数：1 项整行、2 项两列、3 项三列，更多时两列
const cols = count >= 4 ? 2 : Math.max(1, count);
---

<section id={data.id} class="showcase">
  <div class="inner">
    <SectionHeader eyebrow={data.eyebrow} heading={data.heading} intro={data.intro} delay={delay} />
    <div class="grid" data-cols={cols}>
      {
        data.items.map((item, i) => {
          const [p1, p2, p3] = PALETTES[i % PALETTES.length];
          const [c1, c2, c3] = item.accent ? [item.accent[0], item.accent[1], item.accent[1]] : [p1, p2, p3];
          return (
            <a
              class="card"
              href={item.href}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener noreferrer' : undefined}
              data-animate
              data-spotlight
              style={`--animate-delay:${delay + 80 + i * 90}ms;--c1:${c1};--c2:${c2};--c3:${c3}`}
            >
              <div class="cover" aria-hidden="true">
                {item.thumbnail ? (
                  <img src={item.thumbnail} alt="" loading="lazy" decoding="async" />
                ) : (
                  <Fragment>
                    <span class="cover-grid" />
                    <span class="cover-orb" />
                    {item.logo ? (
                      <span class="cover-tile logo">
                        <img src={item.logo} alt="" width="72" height="72" loading="lazy" decoding="async" />
                      </span>
                    ) : (
                      <span class="cover-tile">
                        <Icon name={item.icon ?? 'layers'} size={30} strokeWidth={1.6} />
                      </span>
                    )}
                  </Fragment>
                )}
                {item.badge && <span class="cover-badge">{item.badge}</span>}
              </div>
              <div class="body">
                <div class="title-row">
                  <h3 class="title">{item.title}</h3>
                  <span class="go" aria-hidden="true">
                    <Icon name={item.external ? 'arrowUpRight' : 'arrowRight'} size={16} strokeWidth={2} />
                  </span>
                </div>
                <p class="desc">{item.description}</p>
                {item.tags && item.tags.length > 0 && (
                  <ul class="tags">
                    {item.tags.map((t) => (
                      <li class="tag">{t}</li>
                    ))}
                  </ul>
                )}
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  // 卡片聚光灯：指针位置写入 CSS 变量，由 ::before 径向渐变跟随
  if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    document.querySelectorAll<HTMLElement>('[data-spotlight]').forEach((el) => {
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        el.style.setProperty('--mx', `${e.clientX - r.left}px`);
        el.style.setProperty('--my', `${e.clientY - r.top}px`);
      });
    });
  }
</script>

<style>
  .showcase {
    padding: 6rem 1.5rem;
  }
  .inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .grid[data-cols='1'] {
    grid-template-columns: 1fr;
  }
  .grid[data-cols='3'] {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-xl);
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    isolation: isolate;
    transition:
      transform 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out),
      border-color 0.35s var(--ease-out);
  }
  /* 指针聚光灯 */
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: radial-gradient(
      420px circle at var(--mx, 50%) var(--my, 0%),
      color-mix(in srgb, var(--c1) 10%, transparent),
      transparent 45%
    );
    opacity: 0;
    transition: opacity 0.35s var(--ease-out);
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--c1) 30%, var(--border));
    box-shadow: var(--shadow-lg);
  }
  .card:hover::before {
    opacity: 1;
  }

  /* 封面 */
  .cover {
    position: relative;
    aspect-ratio: 16 / 8;
    overflow: hidden;
    background:
      radial-gradient(120% 120% at 0% 0%, color-mix(in srgb, var(--c1) 22%, white) 0%, transparent 60%),
      radial-gradient(120% 120% at 100% 100%, color-mix(in srgb, var(--c2) 22%, white) 0%, transparent 60%),
      color-mix(in srgb, var(--c3) 25%, white);
    border-bottom: 1px solid var(--border);
  }
  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s var(--ease-out);
  }
  .card:hover .cover img {
    transform: scale(1.03);
  }
  .cover-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(color-mix(in srgb, var(--c1) 14%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--c1) 14%, transparent) 1px, transparent 1px);
    background-size: 28px 28px;
    background-position: center;
    mask-image: radial-gradient(ellipse 60% 70% at 50% 50%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 60% 70% at 50% 50%, #000 20%, transparent 75%);
  }
  .cover-orb {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 180px;
    height: 180px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--c1), var(--c2));
    filter: blur(40px);
    opacity: 0.45;
    transform: translate(-50%, -50%);
    transition:
      transform 0.6s var(--ease-out),
      opacity 0.6s var(--ease-out);
  }
  .card:hover .cover-orb {
    transform: translate(-50%, -50%) scale(1.25);
    opacity: 0.6;
  }
  .cover-tile {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: 20px;
    color: #fff;
    background: linear-gradient(145deg, var(--c1), var(--c2));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.35),
      0 12px 28px -8px color-mix(in srgb, var(--c1) 70%, transparent);
    transform: translate(-50%, -50%);
    transition: transform 0.5s var(--ease-out);
  }
  /* logo 封面：白底圆角容器承载图片，图片自带浅底色，不叠渐变 */
  .cover-tile.logo {
    width: 84px;
    height: 84px;
    border-radius: 22px;
    overflow: hidden;
    background: #fff;
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--c1) 14%, transparent),
      0 14px 30px -10px color-mix(in srgb, var(--c1) 55%, transparent);
  }
  .cover-tile.logo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.18);
  }
  .card:hover .cover-tile {
    transform: translate(-50%, -54%) rotate(-4deg) scale(1.05);
  }
  .cover-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--fg);
    background: rgba(255, 255, 255, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  /* 正文 */
  .body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
    padding: 1.5rem 1.6rem 1.6rem;
  }
  .title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .title {
    margin: 0;
    font-size: 1.1875rem;
    font-weight: 650;
    letter-spacing: -0.015em;
    color: var(--fg);
  }
  .go {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--muted);
    transition:
      color 0.25s var(--ease-out),
      background-color 0.25s var(--ease-out),
      border-color 0.25s var(--ease-out),
      transform 0.25s var(--ease-out);
  }
  .card:hover .go {
    color: #fff;
    background: var(--fg);
    border-color: var(--fg);
    transform: rotate(-45deg);
  }
  .card[target='_blank']:hover .go {
    transform: none;
  }
  .desc {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--muted);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: auto 0 0;
    padding: 0.6rem 0 0;
    list-style: none;
  }
  .tag {
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted-strong);
    background: var(--surface-2);
  }

  @media (max-width: 900px) {
    .grid[data-cols='3'] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .showcase {
      padding: 4.5rem 1.25rem;
    }
    .inner {
      gap: 2rem;
    }
    .grid,
    .grid[data-cols='3'] {
      grid-template-columns: 1fr;
    }
  }
</style>
