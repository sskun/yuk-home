---
import type { ShowcaseSection } from '../config/schema';

interface Props {
  data: ShowcaseSection;
  delay: number;
}
const { data, delay } = Astro.props;
---

<section id={data.id} class="showcase">
  <div class="inner">

    <h2 class="heading" data-animate style={`--animate-delay:${delay}ms`}>
      {data.heading}
    </h2>

    <div class="grid" data-animate="scale" style={`--animate-delay:${delay + 80}ms`}>
      {data.items.map((item) => (
        <a
          class="card"
          href={item.href}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener noreferrer' : undefined}
        >
          <div class="card-inner">
            <div class="card-top">
              <span class="card-title">{item.title}</span>
              {item.external
                ? <svg class="arrow" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                : <svg class="arrow" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              }
            </div>
            <p class="card-desc">{item.description}</p>
            {item.tags && item.tags.length > 0 && (
              <div class="tags">
                {item.tags.map(t => <span class="tag">{t}</span>)}
              </div>
            )}
          </div>
        </a>
      ))}
    </div>

  </div>
</section>

<style>
  .showcase {
    padding: 5rem 1.5rem 6rem;
    border-top: 1px solid var(--border);
  }

  .inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .heading {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-family: var(--font-mono);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .card {
    display: block;
    background: var(--surface);
    text-decoration: none;
    color: inherit;
    transition: background 0.15s;
  }
  .card:hover {
    background: var(--bg-elev);
  }
  .card:hover .arrow {
    transform: translateX(3px);
    color: var(--color-accent);
  }
  .card:hover .card-title {
    color: var(--color-accent);
  }

  .card-inner {
    padding: 1.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    height: 100%;
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .card-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--fg);
    transition: color 0.15s;
  }

  .arrow {
    flex-shrink: 0;
    color: var(--muted);
    transition: transform 0.18s var(--ease-out), color 0.15s;
  }

  .card-desc {
    margin: 0;
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.65;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .tag {
    font-size: 0.7rem;
    font-family: var(--font-mono);
    padding: 0.2em 0.55em;
    border-radius: 4px;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    color: var(--muted-strong);
  }

  @media (max-width: 480px) {
    .showcase { padding: 4rem 1.25rem 5rem; }
    .grid { grid-template-columns: 1fr; }
  }
</style>
