---
import type { ShowcaseSection } from '../config/schema';

// 展示区块：项目/Demo 入口卡片列表（面向未来扩展）。
interface Props {
  data: ShowcaseSection;
  delay: number;
}
const { data, delay } = Astro.props;
---

<section id={data.id} class="showcase">
  <div class="inner">
    <h2 class="heading" data-animate style={`--animate-delay:${delay}ms`}>{data.heading}</h2>
    <div class="grid">
      {
        data.items.map((item, i) => (
          <a
            class="item"
            href={item.href}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
            data-animate="scale"
            style={`--animate-delay:${delay + 120 + i * 90}ms`}
          >
            {item.thumbnail ? (
              <div class="thumb-wrap">
                <img class="thumb" src={item.thumbnail} alt={item.title} loading="lazy" />
              </div>
            ) : (
              <div class="thumb-wrap thumb-placeholder" aria-hidden="true">
                <span class="glyph">{item.title.slice(0, 1)}</span>
              </div>
            )}
            <div class="body">
              <h3 class="item-title">
                {item.title}
                <svg class="arrow" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                  <path
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M5 12h14M13 6l6 6-6 6"
                  />
                </svg>
              </h3>
              <p class="item-desc">{item.description}</p>
              {item.tags && (
                <ul class="tags">
                  {item.tags.map((t) => (
                    <li class="tag">{t}</li>
                  ))}
                </ul>
              )}
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .showcase {
    padding: 6rem 2rem;
  }

  .inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .heading {
    font-size: clamp(1.8rem, 4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.015em;
    text-align: center;
    margin: 0 0 3rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .item {
    display: block;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
    text-decoration: none;
    cursor: pointer;
    transition:
      transform 0.3s var(--ease-out),
      border-color 0.3s var(--ease-out),
      box-shadow 0.3s var(--ease-out);
  }

  .item:hover {
    transform: translateY(-6px);
    border-color: color-mix(in srgb, var(--color-primary) 55%, transparent);
    box-shadow: 0 18px 46px rgba(0, 0, 0, 0.4);
  }

  .thumb-wrap {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s var(--ease-out);
  }

  .item:hover .thumb {
    transform: scale(1.05);
  }

  /* 无缩略图时的占位：渐变底 + 首字母，避免空白 */
  .thumb-placeholder {
    display: grid;
    place-items: center;
    background:
      radial-gradient(120% 120% at 0% 0%, color-mix(in srgb, var(--color-primary) 40%, transparent), transparent 60%),
      radial-gradient(120% 120% at 100% 100%, color-mix(in srgb, var(--color-accent) 35%, transparent), transparent 60%),
      var(--bg-elev);
  }

  .glyph {
    font-family: var(--font-mono);
    font-size: 3rem;
    font-weight: 600;
    color: color-mix(in srgb, var(--fg) 55%, transparent);
  }

  .body {
    padding: 1.5rem;
  }

  .item-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .arrow {
    flex-shrink: 0;
    color: var(--color-accent);
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity 0.25s var(--ease-out),
      transform 0.25s var(--ease-out);
  }

  .item:hover .arrow {
    opacity: 1;
    transform: none;
  }

  .item-desc {
    margin: 0 0 1rem;
    color: var(--muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag {
    font-size: 0.72rem;
    font-family: var(--font-mono);
    padding: 0.22rem 0.6rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-accent) 16%, transparent);
    color: var(--color-accent);
  }
</style>
