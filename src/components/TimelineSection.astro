---
import type { TimelineSection } from '../config/schema';
import SectionHeader from './ui/SectionHeader.astro';

// 经历时间线：左侧时间段，中间节点与连线，右侧内容卡片。
// 连线随滚动"生长"（scroll-driven），不支持的浏览器直接显示完整连线。
interface Props {
  data: TimelineSection;
  delay: number;
}
const { data, delay } = Astro.props;
---

<section id={data.id} class="timeline">
  <div class="inner">
    <SectionHeader eyebrow={data.eyebrow} heading={data.heading} intro={data.intro} delay={delay} />
    <ol class="list">
      <span class="rail" aria-hidden="true"><span class="rail-fill"></span></span>
      {
        data.items.map((item, i) => (
          <li
            class:list={['item', { placeholder: item.placeholder }]}
            data-animate="left"
            style={`--animate-delay:${delay + 60 + i * 90}ms`}
          >
            <span class="period">{item.period}</span>
            <span class="node" aria-hidden="true" />
            <div class="content">
              <h3 class="title">
                {item.title}
                {item.placeholder && <span class="todo">待补充</span>}
              </h3>
              {item.org && <p class="org">{item.org}</p>}
              <p class="desc">{item.description}</p>
              {item.tags && item.tags.length > 0 && (
                <ul class="tags">
                  {item.tags.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .timeline {
    padding: 6rem 1.5rem;
  }
  .inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  .list {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* 竖线位于时间列与内容列之间 */
  .rail {
    position: absolute;
    left: calc(9rem + 1rem);
    top: 0.75rem;
    bottom: 0.75rem;
    width: 2px;
    border-radius: 2px;
    background: var(--border);
    overflow: hidden;
  }
  .rail-fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(var(--grad-a), var(--grad-b), #ec4899);
    transform-origin: top;
  }
  @supports (animation-timeline: view()) {
    .rail-fill {
      animation: grow linear both;
      animation-timeline: view();
      animation-range: entry 20% cover 60%;
    }
  }
  @keyframes grow {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }
  .item {
    position: relative;
    display: grid;
    grid-template-columns: 9rem 2rem minmax(0, 1fr);
    align-items: start;
  }
  .period {
    padding-top: 1.35rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
    text-align: right;
    padding-right: 0.25rem;
  }
  .node {
    justify-self: center;
    width: 14px;
    height: 14px;
    margin-top: 1.5rem;
    border-radius: 50%;
    background: #fff;
    border: 3px solid var(--grad-a);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--grad-a) 14%, transparent);
    z-index: 1;
  }
  .content {
    padding: 1.25rem 1.5rem;
    border-radius: 20px;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-xs);
    transition:
      transform 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out);
  }
  .item:hover .content {
    transform: translateX(4px);
    box-shadow: var(--shadow-md);
  }
  .title {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 650;
    color: var(--fg);
  }
  .org {
    margin: 0.2rem 0 0;
    font-size: 0.875rem;
    color: var(--muted-strong);
  }
  .desc {
    margin: 0.5rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--muted);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }
  .tags li {
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-size: 0.75rem;
    color: var(--muted-strong);
    background: var(--surface-2);
  }
  .todo {
    padding: 0.1rem 0.55rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 500;
    color: #92400e;
    background: #fffbeb;
    border: 1px solid #fde68a;
  }
  .item.placeholder .content {
    border-style: dashed;
    border-color: var(--border-strong);
    background: var(--bg-elev);
    box-shadow: none;
  }
  .item.placeholder .node {
    border-color: var(--border-strong);
    box-shadow: none;
  }
  @media (max-width: 640px) {
    .timeline {
      padding: 4.5rem 1.25rem;
    }
    .inner {
      gap: 2rem;
    }
    .rail {
      left: 6px;
    }
    .item {
      grid-template-columns: 14px minmax(0, 1fr);
      column-gap: 1rem;
    }
    .period {
      grid-column: 2;
      grid-row: 1;
      padding: 0 0 0.4rem;
      text-align: left;
    }
    .node {
      grid-column: 1;
      grid-row: 1;
      margin-top: 0.2rem;
    }
    .content {
      grid-column: 2;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rail-fill {
      animation: none;
    }
  }
</style>
