---
import type { FooterSection } from '../config/schema';

// 页脚区块：版权信息 + 链接列表。
interface Props {
  data: FooterSection;
  delay: number;
}
const { data, delay } = Astro.props;
---

<footer id={data.id} class="footer" data-animate style={`--animate-delay:${delay}ms`}>
  <div class="inner">
    <p class="copyright">{data.copyright}</p>
    {
      data.links.length > 0 && (
        <ul class="links">
          {data.links.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</footer>

<style>
  .footer {
    padding: 3rem 2rem;
    border-top: 1px solid var(--border);
  }

  .inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
  }

  .copyright {
    margin: 0;
    color: var(--muted);
  }

  .links {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .links a:hover {
    color: var(--color-accent);
  }
</style>
