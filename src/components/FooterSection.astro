---
import type { FooterSection } from '../config/schema';

// 页脚区块：版权信息 + 链接列表。
interface Props {
  data: FooterSection;
  delay: number;
}
const { data, delay } = Astro.props;
---

<footer id={data.id} class="footer" data-animate style={`--animate-delay:${delay}ms`}>
  <div class="inner">
    <p class="copyright">{data.copyright}</p>
    {
      data.links.length > 0 && (
        <ul class="links">
          {data.links.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</footer>

<style>
  .footer {
    padding: 3rem 2rem;
    border-top: 1px solid var(--border);
    background: linear-gradient(to top, var(--bg-elev), transparent);
  }

  .inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
  }

  .copyright {
    margin: 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .links {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    position: relative;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s var(--ease-out);
  }

  /* 下划线由中间向两侧展开，纯 transform 动画 */
  .links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -3px;
    height: 1px;
    background: var(--color-accent);
    transform: scaleX(0);
    transition: transform 0.25s var(--ease-out);
  }

  .links a:hover {
    color: var(--color-accent);
  }

  .links a:hover::after {
    transform: scaleX(1);
  }
</style>
