---
import type { FooterSection } from '../config/schema';
import Icon from './ui/Icon.astro';

// 页脚区块：一句话介绍 + 链接 + 版权。
// 不挂 data-animate：页脚位于页面最底部，进入视口判定不稳定，曾出现滚到底仍不显示的情况。
interface Props {
  data: FooterSection;
  delay: number;
}
const { data } = Astro.props;
---

<footer id={data.id} class="footer">
  <div class="inner">
    <div class="top">
      {data.tagline && <p class="tagline">{data.tagline}</p>}
      {
        data.links.length > 0 && (
          <ul class="links">
            {data.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                >
                  {link.label}
                  {link.external && <Icon name="arrowUpRight" size={13} strokeWidth={2} />}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
    <div class="bottom">
      <p class="copyright">{data.copyright}</p>
      <a class="top-btn" href="#top" aria-label="回到顶部">
        <Icon name="arrowRight" size={16} strokeWidth={2} />
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 0 1.5rem 2.5rem;
  }
  .inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
  }
  .tagline {
    margin: 0;
    max-width: 32em;
    font-size: 0.9375rem;
    color: var(--muted-strong);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    min-height: 2.75rem;
    font-size: 0.9375rem;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s var(--ease-out);
  }
  .links a:hover {
    color: var(--fg);
  }
  .bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .copyright {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .top-btn {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--muted);
    transition:
      color 0.2s var(--ease-out),
      border-color 0.2s var(--ease-out),
      transform 0.2s var(--ease-out);
  }
  .top-btn :global(svg) {
    transform: rotate(-90deg);
  }
  .top-btn:hover {
    color: var(--fg);
    border-color: var(--fg);
    transform: translateY(-2px);
  }
</style>
