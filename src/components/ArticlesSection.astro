---
import { getCollection } from 'astro:content';
import type { ArticlesSection } from '../config/schema';
import ArticleRow from './ArticleRow.astro';
import SectionHeader from './ui/SectionHeader.astro';

// 最新文章区块：构建期读取 article 集合（过滤草稿），按发布时间倒序取前 limit 篇。
interface Props {
  data: ArticlesSection;
  delay: number;
  lang?: string;
}
const { data, delay, lang = 'zh-CN' } = Astro.props;

const entries = (await getCollection('article', ({ data: d }) => !d.draft))
  .sort((a, b) => (b.data.pubDate?.getTime() ?? -Infinity) - (a.data.pubDate?.getTime() ?? -Infinity))
  .slice(0, data.limit ?? 3);
---

{
  entries.length > 0 && (
    <section id={data.id} class="articles">
      <div class="inner">
        <SectionHeader eyebrow={data.eyebrow} heading={data.heading} intro={data.intro} more={data.more} delay={delay} />
        <ol class="list">
          {entries.map((entry, i) => (
            <ArticleRow entry={entry} delay={delay + 80 + i * 70} lang={lang} />
          ))}
        </ol>
      </div>
    </section>
  )
}

<style>
  .articles {
    padding: 6rem 1.5rem;
  }
  .inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }
  @media (max-width: 720px) {
    .articles {
      padding: 4.5rem 1.25rem;
    }
  }
</style>
