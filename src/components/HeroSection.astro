---
import type { HeroSection } from '../config/schema';
import Icon from './ui/Icon.astro';

interface Props {
  data: HeroSection;
  delay: number;
}
const { data, delay } = Astro.props;
// 支持 \n 换行；最后一行使用品牌渐变
const headlineParts = data.headline.split('\n');
const profile = data.profile;
const socials = data.socials ?? [];

// 把档案对象拆成「行 → 词法片段」，渲染时每行一个块级 span，避免 <pre> 内的模板空白干扰排版
type Token = { c: string; t: string };
const codeLines: Token[][] = [];
if (profile) {
  codeLines.push([
    { c: 'kw', t: 'const ' },
    { c: 'id', t: profile.variable },
    { c: 'op', t: ' = ' },
    { c: 'pn', t: '{' },
  ]);
  for (const e of profile.entries) {
    const line: Token[] = [{ c: 'key', t: `  ${e.key}` }, { c: 'pn', t: ': ' }];
    if (Array.isArray(e.value)) {
      line.push({ c: 'pn', t: '[' });
      e.value.forEach((v, j) => {
        line.push({ c: 'str', t: `'${v}'` });
        if (j < e.value.length - 1) line.push({ c: 'pn', t: ', ' });
      });
      line.push({ c: 'pn', t: ']' });
    } else {
      line.push({ c: 'str', t: `'${e.value}'` });
    }
    line.push({ c: 'pn', t: ',' });
    codeLines.push(line);
  }
  codeLines.push([{ c: 'pn', t: '};' }]);
}
---

<section id={data.id} class="hero">
  <!-- 背景装饰：极光光斑 + 点阵网格，独立 overflow:hidden 容器，不裁主内容 -->
  <div class="hero-bg" aria-hidden="true">
    <div class="aurora aurora-1"></div>
    <div class="aurora aurora-2"></div>
    <div class="aurora aurora-3"></div>
    <div class="dots"></div>
    <div class="fade"></div>
  </div>

  <div class="hero-inner">
    <!-- 左侧：自我介绍 -->
    <div class="left">
      {
        data.status && (
          <p class="status" data-animate style={`--animate-delay:${delay}ms`}>
            <span class="status-dot" aria-hidden="true"></span>
            {data.status}
          </p>
        )
      }
      {
        data.greeting && (
          <p class="greeting" data-animate style={`--animate-delay:${delay + 60}ms`}>
            {data.greeting}
          </p>
        )
      }
      <h1 class="headline" data-animate style={`--animate-delay:${delay + 120}ms`}>
        {
          headlineParts.map((line, i) => (
            <span class:list={['line', { accent: i === headlineParts.length - 1 && headlineParts.length > 1 }]}>
              {line}
            </span>
          ))
        }
      </h1>
      <p class="sub" data-animate style={`--animate-delay:${delay + 180}ms`}>{data.subheadline}</p>
      <div class="actions" data-animate style={`--animate-delay:${delay + 240}ms`}>
        <div class="ctas">
          {
            data.ctas.map((cta) => (
              <a
                class:list={['cta', cta.variant]}
                href={cta.href}
                target={cta.external ? '_blank' : undefined}
                rel={cta.external ? 'noopener noreferrer' : undefined}
              >
                <span>{cta.label}</span>
                {cta.variant === 'primary' && <Icon name="arrowRight" size={16} strokeWidth={2} />}
              </a>
            ))
          }
        </div>
        {
          socials.length > 0 && (
            <ul class="socials" aria-label="社交链接">
              {socials.map((s) => (
                <li>
                  <a
                    class="social"
                    href={s.href}
                    aria-label={s.label}
                    title={s.label}
                    target={s.external ? '_blank' : undefined}
                    rel={s.external ? 'noopener noreferrer' : undefined}
                  >
                    <Icon name={s.icon} size={18} />
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>

    <!-- 右侧：代码风格的个人档案卡片 -->
    {
      profile && (
        <div class="right" data-animate="scale" style={`--animate-delay:${delay + 200}ms`}>
          <div class="card-glow" aria-hidden="true" />
          <figure class="code-card" data-tilt>
            <figcaption class="code-bar">
              <span class="lights" aria-hidden="true">
                <i />
                <i />
                <i />
              </span>
              <span class="filename">{profile.filename}</span>
              <span class="lang" aria-hidden="true">TS</span>
            </figcaption>
            <pre class="code" aria-label={`${profile.variable} 的个人档案`}><code>{codeLines.map((tokens, i) => (<span class="row"><span class="ln">{i + 1}</span>{tokens.map((t) => <span class={t.c}>{t.t}</span>)}{i === codeLines.length - 1 && <span class="caret" aria-hidden="true" />}</span>))}</code></pre>
          </figure>
        </div>
      )
    }
  </div>

  <a class="scroll-hint" href={`#${data.id}-end`} aria-label="向下浏览">
    <span class="mouse" aria-hidden="true"><span class="wheel"></span></span>
  </a>
  <span id={`${data.id}-end`} class="hero-end" aria-hidden="true"></span>
</section>

<script>
  // 代码卡片 3D 视差：仅在精确指针设备、且未开启减少动态时启用；只改 transform。
  const canTilt =
    window.matchMedia('(hover: hover) and (pointer: fine)').matches &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (canTilt) {
    document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((card) => {
      const host = card.parentElement ?? card;
      let frame = 0;
      host.addEventListener('pointermove', (e) => {
        const r = host.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          card.style.setProperty('--rx', `${(-y * 6).toFixed(2)}deg`);
          card.style.setProperty('--ry', `${(x * 8).toFixed(2)}deg`);
        });
      });
      host.addEventListener('pointerleave', () => {
        cancelAnimationFrame(frame);
        card.style.setProperty('--rx', '0deg');
        card.style.setProperty('--ry', '0deg');
      });
    });
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: min(100svh, 920px);
    display: flex;
    align-items: center;
    padding: 7.5rem 1.5rem 6rem;
    isolation: isolate;
  }

  /* ---------- 背景 ---------- */
  .hero-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: -1;
  }
  .aurora {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.55;
    will-change: transform;
  }
  .aurora-1 {
    width: 620px;
    height: 620px;
    top: -260px;
    right: -120px;
    background: radial-gradient(circle at 30% 30%, #818cf8, transparent 65%);
    animation: drift-1 22s ease-in-out infinite alternate;
  }
  .aurora-2 {
    width: 520px;
    height: 520px;
    top: 10%;
    right: 22%;
    background: radial-gradient(circle at 50% 50%, #e879f9, transparent 65%);
    opacity: 0.32;
    animation: drift-2 26s ease-in-out infinite alternate;
  }
  .aurora-3 {
    width: 560px;
    height: 560px;
    bottom: -280px;
    left: -160px;
    background: radial-gradient(circle at 50% 50%, #67e8f9, transparent 65%);
    opacity: 0.35;
    animation: drift-3 30s ease-in-out infinite alternate;
  }
  @keyframes drift-1 {
    to {
      transform: translate3d(-80px, 60px, 0) scale(1.08);
    }
  }
  @keyframes drift-2 {
    to {
      transform: translate3d(90px, 40px, 0) scale(0.92);
    }
  }
  @keyframes drift-3 {
    to {
      transform: translate3d(70px, -50px, 0) scale(1.1);
    }
  }
  .dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 1px 1px, color-mix(in srgb, var(--fg) 14%, transparent) 1px, transparent 0);
    background-size: 26px 26px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, #000 30%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, #000 30%, transparent 100%);
  }
  .fade {
    position: absolute;
    inset: auto 0 0 0;
    height: 160px;
    background: linear-gradient(to bottom, transparent, var(--bg));
  }

  /* ---------- 布局 ---------- */
  .hero-inner {
    max-width: var(--max-width);
    width: 100%;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }
  .left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* 状态胶囊 */
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 1.75rem;
    padding: 0.35rem 0.85rem 0.35rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 75%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: var(--shadow-xs);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--muted-strong);
  }
  .status-dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
  }
  .status-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #22c55e;
    animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes ping {
    75%,
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  .greeting {
    margin: 0 0 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .greeting::before {
    content: '>';
    margin-right: 0.5rem;
    color: var(--color-accent);
  }

  .headline {
    margin: 0;
    font-size: clamp(2.5rem, 5vw, 4.125rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1.06;
    color: var(--fg);
  }
  .line {
    display: block;
  }
  /* 每行是一个完整短句，宽度允许时不在句中断行（避免「做工 / 具，」这类拆字） */
  @media (min-width: 400px) {
    .line {
      white-space: nowrap;
    }
  }
  .line.accent {
    width: fit-content;
    padding-bottom: 0.06em;
    background: var(--grad-brand);
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shimmer 8s ease-in-out infinite alternate;
  }
  @keyframes shimmer {
    to {
      background-position: 100% 0;
    }
  }

  .sub {
    margin: 1.5rem 0 0;
    max-width: 34em;
    font-size: clamp(1.0625rem, 1.4vw, 1.1875rem);
    line-height: 1.75;
    color: var(--muted);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 1.25rem 1.75rem;
    flex-wrap: wrap;
    margin-top: 2.25rem;
  }
  .ctas {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 3rem;
    padding: 0 1.4rem;
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 0.2s var(--ease-out),
      box-shadow 0.2s var(--ease-out),
      background-color 0.2s var(--ease-out),
      border-color 0.2s var(--ease-out);
  }
  .cta :global(svg) {
    transition: transform 0.2s var(--ease-out);
  }
  .cta:hover :global(svg) {
    transform: translateX(3px);
  }
  .cta:active {
    transform: scale(0.97);
  }
  .cta.primary {
    color: #fff;
    background: var(--fg);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.16),
      0 1px 2px rgba(0, 0, 0, 0.2),
      0 8px 20px -6px color-mix(in srgb, var(--grad-a) 55%, transparent);
  }
  .cta.primary:hover {
    background: var(--fg-soft);
    transform: translateY(-1px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.16),
      0 1px 2px rgba(0, 0, 0, 0.2),
      0 14px 28px -8px color-mix(in srgb, var(--grad-a) 65%, transparent);
  }
  .cta.ghost {
    color: var(--fg);
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    border: 1px solid var(--border-strong);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .cta.ghost:hover {
    border-color: var(--fg);
    transform: translateY(-1px);
  }

  .socials {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0 0 0 1.5rem;
    list-style: none;
    border-left: 1px solid var(--border);
  }
  .social {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    color: var(--muted);
    transition:
      color 0.2s var(--ease-out),
      background-color 0.2s var(--ease-out);
  }
  .social:hover {
    color: var(--fg);
    background: color-mix(in srgb, var(--fg) 6%, transparent);
  }

  /* ---------- 代码卡片 ---------- */
  .right {
    position: relative;
    perspective: 1200px;
  }
  .card-glow {
    position: absolute;
    inset: 8% 6% -6%;
    border-radius: 32px;
    background: var(--grad-brand);
    filter: blur(48px);
    opacity: 0.35;
    z-index: 0;
  }
  .code-card {
    position: relative;
    z-index: 1;
    margin: 0;
    border-radius: 18px;
    overflow: hidden;
    background: #0c0c14;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.6),
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 30px 60px -20px rgba(15, 15, 40, 0.55);
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transform-style: preserve-3d;
    transition: transform 0.5s var(--ease-out);
  }
  /* 卡片顶部一条渐变高光边 */
  .code-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(165, 180, 252, 0.7), transparent);
  }
  .code-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(255, 255, 255, 0.02);
  }
  .lights {
    display: inline-flex;
    gap: 6px;
  }
  .lights i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #3f3f50;
  }
  .lights i:nth-child(1) {
    background: #ff5f57;
  }
  .lights i:nth-child(2) {
    background: #febc2e;
  }
  .lights i:nth-child(3) {
    background: #28c840;
  }
  .filename {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: #a1a1aa;
  }
  .lang {
    margin-left: auto;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    color: #93c5fd;
    background: rgba(59, 130, 246, 0.14);
  }
  .code {
    margin: 0;
    padding: 1.25rem 1.4rem 1.5rem 0.5rem;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.85;
    color: #e4e4e7;
    tab-size: 2;
  }
  .code code {
    font-family: inherit;
  }
  .row {
    display: block;
    white-space: pre;
  }
  .hero-end {
    position: absolute;
    bottom: 0;
  }
  .ln {
    display: inline-block;
    width: 2.25rem;
    padding-right: 1rem;
    text-align: right;
    color: #3f3f50;
    user-select: none;
  }
  .kw {
    color: #c4b5fd;
  }
  .id {
    color: #7dd3fc;
  }
  .op,
  .pn {
    color: #71717a;
  }
  .key {
    color: #e4e4e7;
  }
  .str {
    color: #86efac;
  }
  .caret {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    margin-left: 0.2em;
    vertical-align: -0.2em;
    background: #a5b4fc;
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* ---------- 向下提示 ---------- */
  .scroll-hint {
    position: absolute;
    left: 50%;
    bottom: 1.75rem;
    transform: translateX(-50%);
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: var(--muted);
  }
  .mouse {
    width: 22px;
    height: 34px;
    border: 1.5px solid currentColor;
    border-radius: 12px;
    display: flex;
    justify-content: center;
    padding-top: 6px;
    opacity: 0.6;
    transition: opacity 0.2s;
  }
  .scroll-hint:hover .mouse {
    opacity: 1;
  }
  .wheel {
    width: 3px;
    height: 7px;
    border-radius: 2px;
    background: currentColor;
    animation: wheel 1.8s ease-in-out infinite;
  }
  @keyframes wheel {
    0% {
      transform: translateY(0);
      opacity: 1;
    }
    70% {
      transform: translateY(9px);
      opacity: 0;
    }
    100% {
      transform: translateY(0);
      opacity: 0;
    }
  }

  /* ---------- 响应式 ---------- */
  @media (max-width: 960px) {
    .hero {
      min-height: auto;
      padding: 7rem 1.5rem 5rem;
    }
    .hero-inner {
      grid-template-columns: minmax(0, 1fr);
    }
    .right {
      max-width: 560px;
    }
    .scroll-hint {
      display: none;
    }
  }
  @media (max-width: 540px) {
    .hero {
      padding: 6rem 1.25rem 4rem;
    }
    .status {
      margin-bottom: 1.5rem;
    }
    .actions {
      flex-direction: column;
      align-items: flex-start;
    }
    .socials {
      padding-left: 0;
      border-left: 0;
      margin-left: -0.6rem;
    }
    .code {
      font-size: 0.78rem;
      padding-right: 1rem;
    }
    .ln {
      width: 1.75rem;
      padding-right: 0.75rem;
    }
    .aurora-1 {
      width: 380px;
      height: 380px;
      top: -140px;
      right: -140px;
    }
    .aurora-2 {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aurora,
    .line.accent,
    .status-dot::after,
    .caret,
    .wheel {
      animation: none;
    }
  }
</style>
