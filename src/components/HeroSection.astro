---
import type { HeroSection } from '../config/schema';

// 首屏主视觉区块：简约白色主题
interface Props {
  data: HeroSection;
  delay: number;
}
const { data, delay } = Astro.props;
const effect = data.backgroundEffect ?? 'none';
---

<section id={data.id} class="hero">
  <div class="hero-inner">
    <h1 class="headline" data-animate style={`--animate-delay:${delay}ms`}>
      <span class="gradient-text">{data.headline}</span>
    </h1>
    <p class="subheadline" data-animate style={`--animate-delay:${delay + 120}ms`}>
      {data.subheadline}
    </p>
    <div class="ctas" data-animate style={`--animate-delay:${delay + 240}ms`}>
      {
        data.ctas.map((cta) => (
          <a
            class:list={['cta', cta.variant]}
            href={cta.href}
            target={cta.external ? '_blank' : undefined}
            rel={cta.external ? 'noopener noreferrer' : undefined}
          >
            <span>{cta.label}</span>
            {cta.external && (
              <svg class="ext-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                <path fill="currentColor" d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6m7-1.414l-5.586 5.586-1.414-1.414L18 6.586V5zM13 18l6-6"/>
              </svg>
            )}
          </a>
        ))
      }
    </div>
  </div>
  <a class="scroll-cue" href="#features" aria-label="向下滚动查看更多">
    <span class="mouse-indicator">
      <span class="scroll-dot"></span>
    </span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    text-align: center;
    overflow: hidden;
    padding: 2rem;
    background: linear-gradient(180deg, var(--bg-elev) 0%, var(--bg) 100%);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: var(--max-width);
    padding: 4rem 0;
  }

  .headline {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 0 0 1.5rem;
    color: var(--fg);
  }

  .gradient-text {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-accent) 100%);
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: gradient-shift 8s ease-in-out infinite;
  }

  @keyframes gradient-shift {
    0%, 100% { background-position: 0% center; }
    50% { background-position: 100% center; }
  }

  .subheadline {
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    color: var(--muted);
    margin: 0 0 2.5rem;
    font-family: var(--font-sans);
    font-weight: 400;
    line-height: 1.6;
    max-width: 60ch;
    margin-left: auto;
    margin-right: auto;
  }

  .ctas {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.9rem 1.75rem;
    border-radius: var(--radius-lg);
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s var(--ease-out);
    position: relative;
  }

  .cta:hover {
    transform: translateY(-2px);
  }

  .cta .ext-icon {
    opacity: 0.6;
    transition: opacity 0.3s var(--ease-out);
  }

  .cta:hover .ext-icon {
    opacity: 1;
  }

  .cta.primary {
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(59, 130, 246, 0.25);
    border: none;
  }

  .cta.primary:hover {
    box-shadow: 0 6px 20px rgba(59, 130, 246, 0.35);
    transform: translateY(-3px);
  }

  .cta.ghost {
    background: transparent;
    color: var(--fg);
    border: 2px solid var(--border);
  }

  .cta.ghost:hover {
    border-color: var(--color-accent);
    background: var(--bg-elev);
    color: var(--color-accent);
  }

  /* 滚动提示 */
  .scroll-cue {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    opacity: 0.6;
    transition: opacity 0.3s var(--ease-out);
  }

  .scroll-cue:hover {
    opacity: 1;
  }

  .mouse-indicator {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 40px;
    border-radius: 12px;
    border: 2px solid var(--border);
    background: var(--surface);
  }

  .scroll-dot {
    width: 4px;
    height: 8px;
    background: var(--color-accent);
    border-radius: 4px;
    animation: scroll-bounce 1.6s ease-in-out infinite;
  }

  @keyframes scroll-bounce {
    0%, 100% {
      transform: translateY(0);
      opacity: 1;
    }
    50% {
      transform: translateY(12px);
      opacity: 0.4;
    }
  }

  /* 无障碍 */
  @media (prefers-reduced-motion: reduce) {
    .gradient-text,
    .scroll-dot {
      animation: none;
    }
    .scroll-cue {
      display: none;
    }
  }
</style>
