---
import { getCollection } from 'astro:content';
import type { HeroSection } from '../config/schema';
import Icon from './ui/Icon.astro';
import SmartImage from './ui/SmartImage.astro';

// 首屏：一屏讲清「我是谁、我做了什么、做得怎么样」。
// 左：身份 + 主张 + 行动按钮 + 数据亮点；右：产品舞台（真实截图 / 视频 + 浮动卡片）；底：能力标签带。
// 动画用 motion：入场编排、数字滚动、浮动、滚动视差；JS 失败或减少动态时内容直接可见。
interface Props {
  data: HeroSection;
  delay: number;
}
const { data } = Astro.props;

const headlineParts = data.headline.split('\n');
const socials = data.socials ?? [];
const stage = data.stage;
const floats = (stage?.floats ?? []).slice(0, 3);
const marquee = data.marquee ?? [];

// 'articles' 取已发布文章数，保证数字真实
const needArticles = (data.stats ?? []).some((s) => s.value === 'articles');
const articleCount = needArticles ? (await getCollection('article', ({ data: d }) => !d.draft)).length : 0;
const stats = (data.stats ?? []).map((s) => ({ ...s, n: s.value === 'articles' ? articleCount : s.value }));
const initial = (data.name ?? 'Y').trim().charAt(0).toUpperCase();
---

<section id={data.id} class="hero" data-hero>
  <!-- 背景：柔和的彩色光斑 + 细颗粒，偏 C 端的轻盈质感 -->
  <div class="hero-bg" aria-hidden="true">
    <div class="blob b1"></div>
    <div class="blob b2"></div>
    <div class="blob b3"></div>
    <div class="grain"></div>
    <div class="fade"></div>
  </div>

  <div class="hero-inner">
    <!-- 左侧：自我介绍 -->
    <div class="intro">
      <div class="who" data-hero-in>
        <span class="avatar">
          {
            data.avatar ? (
              <SmartImage src={data.avatar} alt={data.name ?? ''} widths={[112]} sizes="56px" loading="eager" />
            ) : (
              <span class="avatar-initial" aria-hidden="true">{initial}</span>
            )
          }
        </span>
        <span class="who-text">
          {data.name && <span class="who-name">{data.name}</span>}
          {data.role && <span class="who-role">{data.role}</span>}
        </span>
        {
          data.status && (
            <span class="status">
              <span class="status-dot" aria-hidden="true" />
              {data.status}
            </span>
          )
        }
      </div>

      <h1 class="headline">
        {
          headlineParts.map((line, i) => (
            <span class="line-mask">
              <span class:list={['line', { accent: i === headlineParts.length - 1 && headlineParts.length > 1 }]} data-hero-line>
                {line}
              </span>
            </span>
          ))
        }
      </h1>

      <p class="sub" data-hero-in>{data.subheadline}</p>

      <div class="actions" data-hero-in>
        {
          data.ctas.map((cta) => (
            <a
              class:list={['cta', cta.variant]}
              href={cta.href}
              target={cta.external ? '_blank' : undefined}
              rel={cta.external ? 'noopener noreferrer' : undefined}
            >
              <span>{cta.label}</span>
              {cta.variant === 'primary' && <Icon name="arrowRight" size={17} strokeWidth={2} />}
            </a>
          ))
        }
        {
          socials.length > 0 && (
            <ul class="socials" aria-label="社交与联系方式">
              {socials.map((s) => (
                <li>
                  <a
                    class="social"
                    href={s.href}
                    aria-label={s.label}
                    title={s.label}
                    target={s.external ? '_blank' : undefined}
                    rel={s.external ? 'noopener noreferrer' : undefined}
                  >
                    <Icon name={s.icon} size={19} />
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      {
        stats.length > 0 && (
          <dl class="stats" data-hero-in>
            {stats.map((s) => (
              <div class="stat">
                <dt class="stat-label">{s.label}</dt>
                <dd class="stat-value">
                  <span data-count={s.n}>{s.n}</span>
                  {s.suffix && <span class="stat-suffix">{s.suffix}</span>}
                </dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>

    <!-- 右侧：产品舞台 -->
    {
      stage && (
        <div class="stage" data-stage>
          <div class="stage-glow" aria-hidden="true" />
          <div class="window-wrap" data-depth="1">
            <a
              class="window"
              href={stage.product.href}
              target={stage.product.external ? '_blank' : undefined}
              rel={stage.product.external ? 'noopener noreferrer' : undefined}
              data-stage-window
            >
              <span class="chrome" aria-hidden="true">
                <span class="lights">
                  <i />
                  <i />
                  <i />
                </span>
                <span class="address">
                  <Icon name="terminal" size={12} strokeWidth={2} />
                  {stage.address}
                </span>
              </span>
              <span class="screen">
                {stage.video ? (
                  <video src={stage.video.src} poster={stage.video.poster} autoplay muted loop playsinline preload="metadata" />
                ) : stage.image ? (
                  <SmartImage
                    src={stage.image}
                    alt={`${stage.product.name} 产品界面`}
                    widths={[640, 960, 1280]}
                    sizes="(max-width: 960px) 92vw, 600px"
                    loading="eager"
                    fetchpriority="high"
                  />
                ) : (
                  <span class="screen-empty">产品截图 / 视频预留位</span>
                )}
                <span class="screen-shine" aria-hidden="true" />
              </span>
              <span class="product">
                {stage.product.logo && (
                  <span class="product-logo">
                    <SmartImage src={stage.product.logo} alt="" widths={[88]} sizes="44px" loading="eager" />
                  </span>
                )}
                <span class="product-text">
                  <span class="product-name">{stage.product.name}</span>
                  <span class="product-tagline">{stage.product.tagline}</span>
                </span>
                <span class="product-go" aria-hidden="true">
                  <Icon name={stage.product.external ? 'arrowUpRight' : 'arrowRight'} size={16} strokeWidth={2} />
                </span>
              </span>
            </a>
          </div>

          {floats.map((f, i) => {
            const Tag = f.href ? 'a' : 'div';
            return (
              <div class:list={['float', `float-${i + 1}`]} data-depth={i === 1 ? '2.2' : '1.6'}>
                <div class="float-in" data-float>
                  <Tag
                    class="float-card"
                    href={f.href}
                    target={f.href && f.external ? '_blank' : undefined}
                    rel={f.href && f.external ? 'noopener noreferrer' : undefined}
                    data-float-card
                  >
                    <span class:list={['float-icon', { logo: !!f.logo }]}>
                      {f.logo ? <SmartImage src={f.logo} alt="" widths={[80]} sizes="40px" loading="eager" /> : <Icon name={f.icon} size={20} />}
                    </span>
                    <span class="float-text">
                      <span class="float-title">{f.title}</span>
                      <span class="float-caption">{f.caption}</span>
                    </span>
                  </Tag>
                </div>
              </div>
            );
          })}
        </div>
      )
    }
  </div>

  {
    marquee.length > 0 && (
      <div class="marquee" data-hero-in aria-label="技术与能力">
        <div class="marquee-track">
          {[0, 1].map((dup) => (
            <ul class="marquee-list" aria-hidden={dup === 1 ? 'true' : undefined}>
              {marquee.map((m) => (
                <li>{m}</li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    )
  }
</section>

<!--
  动画初始态开关：同步内联执行，在首帧前给 html 加 .hero-anim 隐藏待动画元素，避免闪烁。
  3 秒内动画脚本没跑起来（加载失败 / 报错）就撤掉开关，保证内容一定可见；减少动态时不加开关。
-->
<script is:inline>
  (function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var root = document.documentElement;
    root.classList.add('hero-anim');
    setTimeout(function () {
      if (!root.classList.contains('hero-ready')) root.classList.remove('hero-anim');
    }, 3000);
  })();
</script>

<script>
  import { animate, stagger, inView, scroll } from 'motion';

  const root = document.documentElement;
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const ease = [0.16, 1, 0.3, 1] as const;

  if (hero && !reduce && root.classList.contains('hero-anim')) {
    root.classList.add('hero-ready');

    // 1. 入场编排：标题逐行从遮罩下升起，其余元素模糊淡入，产品舞台随后
    animate(hero.querySelectorAll('[data-hero-line]'), { y: ['105%', '0%'] }, { duration: 0.95, delay: stagger(0.11, { startDelay: 0.25 }), ease });
    animate(
      hero.querySelectorAll('[data-hero-in]'),
      { opacity: [0, 1], y: [22, 0], filter: ['blur(8px)', 'blur(0px)'] },
      { duration: 0.8, delay: stagger(0.09, { startDelay: 0.1 }), ease },
    );
    const win = hero.querySelector<HTMLElement>('[data-stage-window]');
    if (win) {
      animate(win, { opacity: [0, 1], y: [70, 0], scale: [0.92, 1] }, { duration: 1.1, delay: 0.35, ease });
    }
    hero.querySelectorAll<HTMLElement>('[data-float]').forEach((el, i) => {
      animate(el, { opacity: [0, 1], scale: [0.6, 1], y: [24, 0] }, { type: 'spring', stiffness: 220, damping: 18, delay: 0.9 + i * 0.15 });
    });

    // 2. 浮动卡片持续轻微漂浮（错开节奏）
    hero.querySelectorAll<HTMLElement>('[data-float-card]').forEach((el, i) => {
      animate(el, { y: [0, i % 2 ? 10 : -10, 0] }, { duration: 5 + i * 0.8, repeat: Infinity, ease: 'easeInOut', delay: 1.6 + i * 0.3 });
    });

    // 3. 数字滚动：进入视口后从 0 计到目标值
    const counters = hero.querySelectorAll<HTMLElement>('[data-count]');
    counters.forEach((el) => {
      const target = Number(el.dataset.count) || 0;
      el.textContent = '0';
      inView(el, () => {
        animate(0, target, {
          duration: 1.6,
          delay: 0.6,
          ease,
          onUpdate: (v) => {
            el.textContent = String(Math.round(v));
          },
        });
      });
    });

    // 4. 滚动离开首屏时，产品舞台轻微上移缩小，增加纵深感
    const stageEl = hero.querySelector<HTMLElement>('[data-stage]');
    if (stageEl) {
      scroll(animate(stageEl, { y: [0, -60], scale: [1, 0.95], opacity: [1, 0.55] }, { ease: 'linear' }), {
        target: hero,
        offset: ['start start', 'end start'],
      });
    }

    // 5. 指针视差：按层级深度移动，平滑插值
    if (stageEl && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      let tx = 0;
      let ty = 0;
      let cx = 0;
      let cy = 0;
      let raf = 0;
      const tick = () => {
        cx += (tx - cx) * 0.08;
        cy += (ty - cy) * 0.08;
        stageEl.style.setProperty('--px', cx.toFixed(4));
        stageEl.style.setProperty('--py', cy.toFixed(4));
        raf = Math.abs(tx - cx) + Math.abs(ty - cy) > 0.001 ? requestAnimationFrame(tick) : 0;
      };
      hero.addEventListener('pointermove', (e) => {
        const r = hero.getBoundingClientRect();
        tx = (e.clientX - r.left) / r.width - 0.5;
        ty = (e.clientY - r.top) / r.height - 0.5;
        if (!raf) raf = requestAnimationFrame(tick);
      });
      hero.addEventListener('pointerleave', () => {
        tx = 0;
        ty = 0;
        if (!raf) raf = requestAnimationFrame(tick);
      });
    }
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 6.5rem 1.5rem 0;
    isolation: isolate;
    overflow: clip;
  }

  /* ---------- 动画初始态（仅 html.hero-anim 时） ---------- */
  :global(html.hero-anim) [data-hero-in],
  :global(html.hero-anim) [data-stage-window],
  :global(html.hero-anim) [data-float] {
    opacity: 0;
  }
  :global(html.hero-anim) [data-hero-line] {
    transform: translateY(105%);
  }

  /* ---------- 背景 ---------- */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    background: linear-gradient(180deg, #fbfaff 0%, var(--bg) 100%);
  }
  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    will-change: transform;
  }
  .b1 {
    width: 720px;
    height: 720px;
    top: -320px;
    right: -160px;
    background: radial-gradient(circle, rgba(129, 140, 248, 0.55), transparent 65%);
    animation: drift-a 24s ease-in-out infinite alternate;
  }
  .b2 {
    width: 560px;
    height: 560px;
    top: 18%;
    right: 26%;
    background: radial-gradient(circle, rgba(244, 114, 182, 0.28), transparent 65%);
    animation: drift-b 28s ease-in-out infinite alternate;
  }
  .b3 {
    width: 620px;
    height: 620px;
    bottom: -300px;
    left: -200px;
    background: radial-gradient(circle, rgba(251, 191, 36, 0.24), transparent 65%);
    animation: drift-a 32s ease-in-out infinite alternate-reverse;
  }
  @keyframes drift-a {
    to {
      transform: translate3d(-90px, 70px, 0) scale(1.1);
    }
  }
  @keyframes drift-b {
    to {
      transform: translate3d(100px, -40px, 0) scale(0.9);
    }
  }
  /* 细颗粒：让渐变不显得"数码平涂" */
  .grain {
    position: absolute;
    inset: 0;
    opacity: 0.35;
    mix-blend-mode: soft-light;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)' opacity='0.6'/></svg>");
  }
  .fade {
    position: absolute;
    inset: auto 0 0 0;
    height: 200px;
    background: linear-gradient(to bottom, transparent, var(--bg));
  }

  /* ---------- 布局 ---------- */
  .hero-inner {
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    align-items: center;
    gap: clamp(2rem, 4vw, 3.5rem);
    flex: 1;
  }
  .intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* 身份行 */
  .who {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 0.9rem;
    margin-bottom: 1.75rem;
  }
  .avatar {
    position: relative;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    border-radius: 50%;
    padding: 2.5px;
    background: conic-gradient(from 180deg, var(--grad-a), var(--grad-b), #f472b6, #fbbf24, var(--grad-a));
    box-shadow: 0 8px 20px -8px rgba(99, 102, 241, 0.55);
  }
  .avatar :global(img),
  .avatar-initial {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 2.5px solid #fff;
    object-fit: cover;
  }
  .avatar-initial {
    display: grid;
    place-items: center;
    background: linear-gradient(145deg, #1e1b4b, #312e81);
    color: #fff;
    font-weight: 700;
    font-size: 1.15rem;
  }
  .who-text {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .who-name {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--fg);
  }
  .who-role {
    font-size: 0.875rem;
    color: var(--muted);
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.8rem 0.3rem 0.65rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(34, 197, 94, 0.25);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font-size: 0.8125rem;
    font-weight: 500;
    color: #15803d;
  }
  .status-dot {
    position: relative;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #22c55e;
  }
  .status-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #22c55e;
    animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes ping {
    75%,
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  /* 主标题 */
  .headline {
    margin: 0;
    font-size: clamp(2.75rem, 5.6vw, 4.5rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.045em;
    color: var(--fg);
  }
  .line-mask {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }
  .line {
    display: block;
    width: fit-content;
    white-space: nowrap;
  }
  .line.accent {
    background: linear-gradient(100deg, #4f46e5 0%, #9333ea 45%, #ec4899 80%, #f59e0b 110%);
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shimmer 9s ease-in-out infinite alternate;
  }
  @keyframes shimmer {
    to {
      background-position: 100% 0;
    }
  }
  .sub {
    margin: 1.5rem 0 0;
    max-width: 33em;
    font-size: clamp(1.0625rem, 1.3vw, 1.1875rem);
    line-height: 1.75;
    color: var(--muted-strong);
  }

  /* 行动按钮 */
  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 3.25rem;
    padding: 0 1.6rem;
    border-radius: 999px;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 0.25s var(--ease-out),
      box-shadow 0.25s var(--ease-out),
      background-color 0.25s var(--ease-out),
      border-color 0.25s var(--ease-out);
  }
  .cta:active {
    transform: scale(0.97);
  }
  .cta :global(svg) {
    transition: transform 0.25s var(--ease-out);
  }
  .cta:hover :global(svg) {
    transform: translateX(3px);
  }
  .cta.primary {
    position: relative;
    color: #fff;
    background: linear-gradient(135deg, #4f46e5, #7c3aed 60%, #db2777);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.25),
      0 10px 28px -8px rgba(124, 58, 237, 0.65);
  }
  .cta.primary:hover {
    transform: translateY(-2px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.25),
      0 16px 36px -10px rgba(124, 58, 237, 0.75);
  }
  .cta.ghost {
    color: var(--fg);
    background: rgba(255, 255, 255, 0.75);
    border: 1px solid var(--border-strong);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .cta.ghost:hover {
    border-color: var(--fg);
    transform: translateY(-2px);
  }
  .socials {
    display: flex;
    gap: 0.125rem;
    margin: 0 0 0 0.25rem;
    padding: 0;
    list-style: none;
  }
  .social {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    color: var(--muted);
    transition:
      color 0.2s var(--ease-out),
      background-color 0.2s var(--ease-out);
  }
  .social:hover {
    color: var(--fg);
    background: rgba(255, 255, 255, 0.8);
  }

  /* 数据亮点 */
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 0;
    margin: 2.5rem 0 0;
    padding: 0;
  }
  .stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.2rem;
    padding: 0 1.75rem;
    border-left: 1px solid var(--border);
  }
  .stat:first-child {
    padding-left: 0;
    border-left: 0;
  }
  .stat-value {
    margin: 0;
    font-size: clamp(1.75rem, 2.6vw, 2.25rem);
    font-weight: 750;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }
  .stat-suffix {
    margin-left: 0.1em;
    font-size: 0.6em;
    font-weight: 650;
    color: var(--grad-b);
  }
  .stat-label {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  /* ---------- 产品舞台 ---------- */
  .stage {
    --px: 0;
    --py: 0;
    position: relative;
    padding: 3rem 0 3.5rem 1.5rem;
  }
  /* 宽屏时舞台向右出血，产品窗口更大更有存在感 */
  @media (min-width: 1240px) {
    .stage {
      margin-right: -4rem;
    }
  }
  .stage-glow {
    position: absolute;
    inset: 10% 0 4%;
    border-radius: 40px;
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.45), rgba(236, 72, 153, 0.35), rgba(251, 191, 36, 0.3));
    filter: blur(60px);
    opacity: 0.6;
  }
  .window-wrap {
    position: relative;
