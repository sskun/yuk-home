---
import type { LinkItem } from '../../config/schema';
import Icon from './Icon.astro';
// 首页各区块统一的标题栏：眉标 + 大标题 + 引言，右侧可选"查看全部"链接。
interface Props {
  eyebrow?: string;
  heading: string;
  intro?: string;
  more?: LinkItem;
  delay?: number;
}
const { eyebrow, heading, intro, more, delay = 0 } = Astro.props;
---
<header class="sh" data-animate style={`--animate-delay:${delay}ms`}>
  <div class="sh-text">
    {eyebrow && <p class="sh-eyebrow">{eyebrow}</p>}
    <h2 class="sh-heading">{heading}</h2>
    {intro && <p class="sh-intro">{intro}</p>}
  </div>
  {
    more && (
      <a
        class="sh-more"
        href={more.href}
        target={more.external ? '_blank' : undefined}
        rel={more.external ? 'noopener noreferrer' : undefined}
      >
        {more.label}
        <Icon name="arrowRight" size={16} />
      </a>
    )
  }
</header>

<style>
  .sh {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .sh-text {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 40rem;
  }
  .sh-eyebrow {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .sh-eyebrow::before {
    content: '';
    width: 1.5rem;
    height: 1px;
    background: currentColor;
    opacity: 0.6;
  }
  .sh-heading {
    margin: 0;
    font-size: clamp(1.75rem, 3.2vw, 2.5rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--fg);
  }
  .sh-intro {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--muted);
  }
  .sh-more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.25rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--muted-strong);
    text-decoration: none;
    transition: color 0.2s var(--ease-out);
  }
  .sh-more :global(svg) {
    transition: transform 0.2s var(--ease-out);
  }
  .sh-more:hover {
    color: var(--color-accent);
  }
  .sh-more:hover :global(svg) {
    transform: translateX(3px);
  }
</style>
