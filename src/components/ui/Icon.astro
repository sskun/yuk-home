---
import { SITE_ICONS, isSiteIcon } from './site-icons';
// 统一图标出口：登记过的名字渲染 SVG，其余按文本输出（兼容旧 emoji 配置）。
interface Props {
  name?: string;
  size?: number;
  strokeWidth?: number;
  class?: string;
}
const { name, size = 20, strokeWidth = 1.75, class: className } = Astro.props;
---
{
  isSiteIcon(name) ? (
    <svg
      class={className}
      viewBox="0 0 24 24"
      width={size}
      height={size}
      fill="none"
      stroke="currentColor"
      stroke-width={strokeWidth}
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      set:html={SITE_ICONS[name]}
    />
  ) : name ? (
    <span class={className} aria-hidden="true">{name}</span>
  ) : null
}
