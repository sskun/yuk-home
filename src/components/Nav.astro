---
import type { NavConfig } from '../config/schema';

// 简约现代导航栏 - 白色主题
interface Props {
  nav: NavConfig;
}
const { nav } = Astro.props;

const pathname = Astro.url.pathname;
// 归一化：去掉末尾斜杠便于比较（首页 '/' 保留）
const normalize = (p: string) => (p.length > 1 ? p.replace(/\/$/, '') : p);
const current = normalize(pathname);

function isActive(href: string, external?: boolean): boolean {
  if (external) return false;
  const target = normalize(href);
  if (target === '/') return current === '/';
  return current === target || current.startsWith(target + '/');
}
---

<header class="nav" data-nav>
  <nav class="nav-inner" aria-label="主导航">
    <a class="brand" href="/" aria-label={`${nav.brand} 首页`}>
      <span class="brand-name">{nav.brand}</span>
    </a>
    <ul class="links">
      {
        nav.links.map((link) => (
          <li>
            <a
              class:list={['link', { active: isActive(link.href, link.external) }]}
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
              aria-current={isActive(link.href, link.external) ? 'page' : undefined}
            >
              {link.label}
              {link.external && (
                <svg class="ext-icon" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                  <path fill="currentColor" d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6m7-1.414l-5.586 5.586-1.414-1.414L18 6.586V5zM13 18l6-6"/>
                </svg>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  // 滚动增强：下滑超过阈值给导航加 .scrolled，加深玻璃背景与阴影
  const el = document.querySelector<HTMLElement>('[data-nav]');
  if (el) {
    let ticking = false;
    const update = () => {
      el.classList.toggle('scrolled', window.scrollY > 12);
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }
</script>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 1rem 0;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    transition: all 0.3s var(--ease-out);
  }

  .nav.scrolled {
    padding: 0.75rem 0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  .nav-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 1.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: var(--fg);
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius);
    transition: all 0.2s var(--ease-out);
  }

  .brand:hover {
    background: var(--bg-elev);
    color: var(--color-accent);
  }

  .links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.6rem 1rem;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    white-space: nowrap;
    border-radius: var(--radius);
    transition: all 0.2s var(--ease-out);
    position: relative;
  }

  .link::after {
    content: '';
    position: absolute;
    bottom: 0.5rem;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 2px;
    background: var(--color-accent);
    border-radius: 2px;
    transition: width 0.2s var(--ease-out);
  }

  .link:hover {
    color: var(--fg);
    background: var(--bg-elev);
  }

  .link:hover::after {
    width: calc(100% - 1rem);
  }

  .link.active {
    color: var(--color-accent);
    font-weight: 600;
  }

  .link.active::after {
    width: calc(100% - 1rem);
  }

  .link .ext-icon {
    opacity: 0.5;
    transition: opacity 0.2s var(--ease-out);
  }

  .link:hover .ext-icon {
    opacity: 0.8;
  }

  @media (max-width: 480px) {
    .nav {
      padding: 0.75rem 0;
    }
    
    .nav-inner {
      padding: 0 1rem;
    }

    .brand-name {
      font-size: 1.1rem;
    }

    .link {
      padding: 0.5rem 0.75rem;
      font-size: 0.9rem;
    }
  }
</style>
