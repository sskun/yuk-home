---
import type { NavConfig } from '../config/schema';
import Icon from './ui/Icon.astro';

// 全站导航栏：顶部透明，滚动后变为毛玻璃并出现分隔线
interface Props {
  nav: NavConfig;
}
const { nav } = Astro.props;

const pathname = Astro.url.pathname;
// 归一化：去掉末尾斜杠便于比较（首页 '/' 保留）
const normalize = (p: string) => (p.length > 1 ? p.replace(/\/$/, '') : p);
const current = normalize(pathname);

function isActive(href: string, external?: boolean): boolean {
  if (external) return false;
  const target = normalize(href);
  if (target === '/') return current === '/';
  return current === target || current.startsWith(target + '/');
}
---
<header class="nav" data-nav>
  <nav class="nav-inner" aria-label="主导航">
    <a class="brand" href="/" aria-label={`${nav.brand} 首页`}>
      <span class="brand-mark" aria-hidden="true">{nav.brand.charAt(0).toUpperCase()}</span>
      <span class="brand-name">{nav.brand}</span>
    </a>
    <ul class="links">
      {
        nav.links.map((link) => (
          <li>
            <a
              class:list={['link', { active: isActive(link.href, link.external) }]}
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
              aria-current={isActive(link.href, link.external) ? 'page' : undefined}
            >
              {link.label}
              {link.external && <Icon class="ext-icon" name="arrowUpRight" size={14} strokeWidth={2} />}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  // 滚动增强：下滑超过阈值给导航加 .scrolled，出现毛玻璃背景与分隔线
  const el = document.querySelector<HTMLElement>('[data-nav]');
  if (el) {
    let ticking = false;
    const update = () => {
      el.classList.toggle('scrolled', window.scrollY > 8);
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }
</script>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    border-bottom: 1px solid transparent;
    background: transparent;
    transition:
      background-color 0.3s var(--ease-out),
      border-color 0.3s var(--ease-out),
      box-shadow 0.3s var(--ease-out);
  }
  .nav.scrolled {
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: saturate(180%) blur(16px);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    border-bottom-color: color-mix(in srgb, var(--border) 80%, transparent);
  }
  .nav-inner {
    max-width: calc(var(--max-width) + 3rem);
    height: 4rem;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 1.5rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    margin-left: -0.25rem;
    padding: 0.25rem;
    border-radius: 10px;
    text-decoration: none;
    color: var(--fg);
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: -0.02em;
  }
  .brand-mark {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 9px;
    background: var(--fg);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 700;
    position: relative;
    overflow: hidden;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.18), var(--shadow-sm);
    transition: transform 0.3s var(--ease-out);
  }
  /* 品牌块底部一抹渐变高光 */
  .brand-mark::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 45%;
    background: var(--grad-brand);
    opacity: 0.85;
    filter: blur(6px);
  }
  .brand-mark {
    isolation: isolate;
  }
  .brand-mark::after {
    z-index: -1;
  }
  .brand:hover .brand-mark {
    transform: rotate(-6deg) scale(1.04);
  }
  .links {
    display: flex;
    align-items: center;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 2.25rem;
    padding: 0 0.875rem;
    border-radius: 999px;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    white-space: nowrap;
    transition:
      color 0.2s var(--ease-out),
      background-color 0.2s var(--ease-out);
  }
  .link:hover {
    color: var(--fg);
    background: color-mix(in srgb, var(--fg) 5%, transparent);
  }
  .link.active {
    color: var(--fg);
    background: color-mix(in srgb, var(--fg) 6%, transparent);
  }
  .link :global(.ext-icon) {
    opacity: 0.55;
    transition:
      opacity 0.2s var(--ease-out),
      transform 0.2s var(--ease-out);
  }
  .link:hover :global(.ext-icon) {
    opacity: 1;
    transform: translate(1px, -1px);
  }
  @media (max-width: 520px) {
    .nav-inner {
      height: 3.5rem;
      padding: 0 1rem;
    }
    .link {
      padding: 0 0.7rem;
      font-size: 0.875rem;
    }
  }
</style>
