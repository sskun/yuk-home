---
import type { PillarsSection } from '../config/schema';
import Icon from './ui/Icon.astro';
import SectionHeader from './ui/SectionHeader.astro';

// 能力区块（Bento 布局）：每张卡一个核心数字 + 一句主张 + 证据要点。
// 布局按 4 张设计：第 1、4 张占两列，形成错落；数量不同时自动回落为等宽网格。
interface Props {
  data: PillarsSection;
  delay: number;
}
const { data, delay } = Astro.props;
const TINTS: [string, string][] = [
  ['#4f46e5', '#a855f7'],
  ['#0891b2', '#10b981'],
  ['#db2777', '#f59e0b'],
  ['#334155', '#64748b'],
];
const bento = data.items.length === 4;
---

<section id={data.id} class="pillars">
  <div class="inner">
    <SectionHeader eyebrow={data.eyebrow} heading={data.heading} intro={data.intro} delay={delay} />
    <div class:list={['grid', { bento }]}>
      {
        data.items.map((item, i) => {
          const [c1, c2] = TINTS[i % TINTS.length];
          return (
            <article
              class:list={['card', { placeholder: item.placeholder }]}
              data-animate="scale"
              style={`--animate-delay:${delay + 60 + i * 90}ms;--c1:${c1};--c2:${c2}`}
            >
              <span class="glow" aria-hidden="true" />
              <header class="top">
                {item.icon && (
                  <span class="icon">
                    <Icon name={item.icon} size={20} />
                  </span>
                )}
                <h3 class="title">{item.title}</h3>
                {item.placeholder && <span class="todo">待补充</span>}
              </header>
              <p class="metric">
                <span class="metric-value">{item.metric}</span>
                <span class="metric-label">{item.metricLabel}</span>
              </p>
              <p class="desc">{item.description}</p>
              {item.points && item.points.length > 0 && (
                <ul class="points">
                  {item.points.map((p) => (
                    <li>
                      <span class="tick" aria-hidden="true" />
                      {p}
                    </li>
                  ))}
                </ul>
              )}
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .pillars {
    padding: 6rem 1.5rem;
  }
  .inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  .grid.bento {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .grid.bento .card:nth-child(1),
  .grid.bento .card:nth-child(4) {
    grid-column: span 2;
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.9rem;
    border-radius: 24px;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    isolation: isolate;
    transition:
      transform 0.4s var(--ease-out),
      box-shadow 0.4s var(--ease-out),
      border-color 0.4s var(--ease-out);
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: color-mix(in srgb, var(--c1) 25%, var(--border));
  }
  .glow {
    position: absolute;
    z-index: -1;
    width: 340px;
    height: 340px;
    top: -170px;
    right: -120px;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--c2) 26%, transparent), transparent 65%);
    transition: transform 0.7s var(--ease-out);
  }
  .card:hover .glow {
    transform: scale(1.25) translate(-20px, 20px);
  }
  .top {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  .icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    color: #fff;
    background: linear-gradient(145deg, var(--c1), var(--c2));
    box-shadow: 0 8px 18px -8px color-mix(in srgb, var(--c1) 70%, transparent);
  }
  .title {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 650;
    color: var(--fg);
  }
  .todo {
    margin-left: auto;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    font-size: 0.72rem;
    color: #92400e;
    background: #fffbeb;
    border: 1px solid #fde68a;
  }
  .metric {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    margin: 0.5rem 0 0;
  }
  .metric-value {
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    background: linear-gradient(120deg, var(--c1), var(--c2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .metric-label {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--muted-strong);
  }
  .desc {
    margin: 0;
    max-width: 36em;
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--muted);
  }
  .points {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0.4rem 0 0;
    padding: 0;
    list-style: none;
  }
  .points li {
    display: flex;
    gap: 0.6rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--fg-soft);
  }
  .tick {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    margin-top: 0.15rem;
    border-radius: 50%;
    background:
      url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'><path d='M5 12.5 10 17 19 7'/></svg>")
        center / 11px no-repeat,
      linear-gradient(145deg, var(--c1), var(--c2));
  }
  .card.placeholder {
    border-style: dashed;
    border-color: var(--border-strong);
    background: repeating-linear-gradient(-45deg, var(--surface) 0 14px, var(--bg-elev) 14px 15px);
    box-shadow: none;
  }
  @media (max-width: 860px) {
    .grid.bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .grid.bento .card:nth-child(4) {
      grid-column: span 1;
    }
    .grid.bento .card:nth-child(1) {
      grid-column: span 2;
    }
  }
  @media (max-width: 600px) {
    .pillars {
      padding: 4.5rem 1.25rem;
    }
    .inner {
      gap: 2rem;
    }
    .grid.bento {
      grid-template-columns: 1fr;
    }
    .grid.bento .card:nth-child(n) {
      grid-column: auto;
    }
    .card {
      padding: 1.5rem;
    }
  }
</style>
